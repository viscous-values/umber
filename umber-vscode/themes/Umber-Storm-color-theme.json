  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": { "foreground": "#848DAA", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": { "foreground": "#77DB88" }
    },
    {
      "name": "String escape sequences",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": { "foreground": "#FA9259" }
    },
    {
      "name": "Numbers, booleans, null",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": { "foreground": "#FA9259" }
    },
    {
      "name": "Constants",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember",
        "constant.other"
      ],
      "settings": { "foreground": "#FA9259" }
    },
    {
      "name": "Keywords (control flow, async/await, return)",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.expression",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.logical",
        "keyword.operator.ternary"
      ],
      "settings": { "foreground": "#BB8AEF" }
    },
    {
      "name": "Storage (const, let, function, class, async)",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#BB8AEF" }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison"
      ],
      "settings": { "foreground": "#99A0B1" }
    },
    {
      "name": "Types",
      "scope": [
        "support.type",
        "entity.name.type",
        "entity.other.inherited-class",
        "meta.type.annotation entity.name.type"
      ],
      "settings": { "foreground": "#79D8BB" }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.class",
        "entity.name.namespace",
        "support.class"
      ],
      "settings": { "foreground": "#79D8BB" }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.method.declaration entity.name.function"
      ],
      "settings": { "foreground": "#55C6F4" }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": { "foreground": "#BFC9E0", "fontStyle": "italic" }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.property-name"
      ],
      "settings": { "foreground": "#BFC9E0" }
    },
    {
      "name": "Object keys (JSON, YAML)",
      "scope": [
        "support.type.property-name",
        "string.quoted.double.json support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": { "foreground": "#55C6F4" }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": { "foreground": "#BFC9E0" }
    },
    {
      "name": "Built-in / language variables (this, self, super)",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": { "foreground": "#BB8AEF", "fontStyle": "italic" }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "tag.decorator"
      ],
      "settings": { "foreground": "#79D8BB" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": { "foreground": "#99A0B1" }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "constant.character.escape.regexp"
      ],
      "settings": { "foreground": "#41B0BC" }
    },
    {
      "name": "HTML/JSX tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag",
        "meta.tag.attributes"
      ],
      "settings": { "foreground": "#EC6771" }
    },
    {
      "name": "HTML/JSX attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": { "foreground": "#79D8BB", "fontStyle": "italic" }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": { "foreground": "#EC6771" }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": { "foreground": "#55C6F4" }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value.css",
        "constant.numeric.css",
        "support.constant.color"
      ],
      "settings": { "foreground": "#FA9259" }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": { "foreground": "#BB8AEF", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold.markdown"
      ],
      "settings": { "foreground": "#D5DCEF", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic.markdown"
      ],
      "settings": { "foreground": "#D5DCEF", "fontStyle": "italic" }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title.markdown",
        "constant.other.reference.link.markdown"
      ],
      "settings": { "foreground": "#55C6F4", "fontStyle": "underline" }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": { "foreground": "#77DB88" }
    },
    {
      "name": "Markdown lists",
      "scope": [
        "markup.list",
        "punctuation.definition.list.begin"
      ],
      "settings": { "foreground": "#FA9259" }
    },
    {
      "name": "Markdown quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": { "foreground": "#848DAA", "fontStyle": "italic" }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted"
      ],
      "settings": { "foreground": "#77DB88" }
    },
    {
      "name": "Diff removed",
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted"
      ],
      "settings": { "foreground": "#EC6771" }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": { "foreground": "#FBA541" }
    },
    {
      "name": "Invalid / illegal",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": { "foreground": "#EC6771", "fontStyle": "underline" }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": { "foreground": "#99A0B1", "fontStyle": "strikethrough" }
    }
  ],

  "semanticTokenColors": {
    "type":      "#79D8BB",
    "class":     "#79D8BB",
    "interface": "#79D8BB",
    "enum":      "#79D8BB",
    "struct":    "#79D8BB",
    "typeParameter": { "foreground": "#79D8BB", "italic": true },

    "namespace": "#55C6F4",
    "function":  "#55C6F4",
    "method":    "#55C6F4",
    "macro":     "#BB8AEF",

    "property":   "#BFC9E0",
    "variable":   "#BFC9E0",
    "parameter":  { "foreground": "#BFC9E0", "italic": true },
    "enumMember": "#FA9259",

    "keyword":  "#BB8AEF",
    "operator": "#99A0B1",
    "comment":  { "foreground": "#848DAA", "italic": true },
    "string":   "#77DB88",
    "number":   "#FA9259",
    "regexp":   "#41B0BC",

    "*.declaration":  { "bold": true },
    "*.deprecated":   { "strikethrough": true },
    "*.readonly":     "#FA9259"
  }
}
