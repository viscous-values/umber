  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": { "foreground": "#958676", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": { "foreground": "#9FC56B" }
    },
    {
      "name": "String escape sequences",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": { "foreground": "#F2A660" }
    },
    {
      "name": "Numbers, booleans, null",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": { "foreground": "#F2A660" }
    },
    {
      "name": "Constants",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember",
        "constant.other"
      ],
      "settings": { "foreground": "#F2A660" }
    },
    {
      "name": "Keywords (control flow, async/await, return)",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.expression",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.logical",
        "keyword.operator.ternary"
      ],
      "settings": { "foreground": "#D988A8" }
    },
    {
      "name": "Storage (const, let, function, class, async)",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#D988A8" }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison"
      ],
      "settings": { "foreground": "#AA9E8B" }
    },
    {
      "name": "Types",
      "scope": [
        "support.type",
        "entity.name.type",
        "entity.other.inherited-class",
        "meta.type.annotation entity.name.type"
      ],
      "settings": { "foreground": "#8CCAAF" }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.class",
        "entity.name.namespace",
        "support.class"
      ],
      "settings": { "foreground": "#8CCAAF" }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.method.declaration entity.name.function"
      ],
      "settings": { "foreground": "#80BAE4" }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": { "foreground": "#D9C6A8", "fontStyle": "italic" }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.property-name"
      ],
      "settings": { "foreground": "#D9C6A8" }
    },
    {
      "name": "Object keys (JSON, YAML)",
      "scope": [
        "support.type.property-name",
        "string.quoted.double.json support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": { "foreground": "#80BAE4" }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": { "foreground": "#D9C6A8" }
    },
    {
      "name": "Built-in / language variables (this, self, super)",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": { "foreground": "#D988A8", "fontStyle": "italic" }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "tag.decorator"
      ],
      "settings": { "foreground": "#8CCAAF" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": { "foreground": "#AA9E8B" }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "constant.character.escape.regexp"
      ],
      "settings": { "foreground": "#5DAEAE" }
    },
    {
      "name": "HTML/JSX tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag",
        "meta.tag.attributes"
      ],
      "settings": { "foreground": "#E66F64" }
    },
    {
      "name": "HTML/JSX attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": { "foreground": "#8CCAAF", "fontStyle": "italic" }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": { "foreground": "#E66F64" }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": { "foreground": "#80BAE4" }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value.css",
        "constant.numeric.css",
        "support.constant.color"
      ],
      "settings": { "foreground": "#F2A660" }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": { "foreground": "#D988A8", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold.markdown"
      ],
      "settings": { "foreground": "#EBDABF", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic.markdown"
      ],
      "settings": { "foreground": "#EBDABF", "fontStyle": "italic" }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title.markdown",
        "constant.other.reference.link.markdown"
      ],
      "settings": { "foreground": "#80BAE4", "fontStyle": "underline" }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": { "foreground": "#9FC56B" }
    },
    {
      "name": "Markdown lists",
      "scope": [
        "markup.list",
        "punctuation.definition.list.begin"
      ],
      "settings": { "foreground": "#F2A660" }
    },
    {
      "name": "Markdown quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": { "foreground": "#958676", "fontStyle": "italic" }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted"
      ],
      "settings": { "foreground": "#9FC56B" }
    },
    {
      "name": "Diff removed",
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted"
      ],
      "settings": { "foreground": "#E66F64" }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": { "foreground": "#EDD473" }
    },
    {
      "name": "Invalid / illegal",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": { "foreground": "#E66F64", "fontStyle": "underline" }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": { "foreground": "#AA9E8B", "fontStyle": "strikethrough" }
    }
  ],

  "semanticTokenColors": {
    "type":      "#8CCAAF",
    "class":     "#8CCAAF",
    "interface": "#8CCAAF",
    "enum":      "#8CCAAF",
    "struct":    "#8CCAAF",
    "typeParameter": { "foreground": "#8CCAAF", "italic": true },

    "namespace": "#80BAE4",
    "function":  "#80BAE4",
    "method":    "#80BAE4",
    "macro":     "#D988A8",

    "property":   "#D9C6A8",
    "variable":   "#D9C6A8",
    "parameter":  { "foreground": "#D9C6A8", "italic": true },
    "enumMember": "#F2A660",

    "keyword":  "#D988A8",
    "operator": "#AA9E8B",
    "comment":  { "foreground": "#958676", "italic": true },
    "string":   "#9FC56B",
    "number":   "#F2A660",
    "regexp":   "#5DAEAE",

    "*.declaration":  { "bold": true },
    "*.deprecated":   { "strikethrough": true },
    "*.readonly":     "#F2A660"
  }
}
