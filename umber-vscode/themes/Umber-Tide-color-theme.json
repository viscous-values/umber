  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": { "foreground": "#789292", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": { "foreground": "#BCC270" }
    },
    {
      "name": "String escape sequences",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": { "foreground": "#E5B568" }
    },
    {
      "name": "Numbers, booleans, null",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": { "foreground": "#E5B568" }
    },
    {
      "name": "Constants",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember",
        "constant.other"
      ],
      "settings": { "foreground": "#E5B568" }
    },
    {
      "name": "Keywords (control flow, async/await, return)",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.expression",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.logical",
        "keyword.operator.ternary"
      ],
      "settings": { "foreground": "#BE94D8" }
    },
    {
      "name": "Storage (const, let, function, class, async)",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#BE94D8" }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison"
      ],
      "settings": { "foreground": "#9DA296" }
    },
    {
      "name": "Types",
      "scope": [
        "support.type",
        "entity.name.type",
        "entity.other.inherited-class",
        "meta.type.annotation entity.name.type"
      ],
      "settings": { "foreground": "#7DD8B6" }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.class",
        "entity.name.namespace",
        "support.class"
      ],
      "settings": { "foreground": "#7DD8B6" }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.method.declaration entity.name.function"
      ],
      "settings": { "foreground": "#7CC0E3" }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": { "foreground": "#C5CCBB", "fontStyle": "italic" }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.property-name"
      ],
      "settings": { "foreground": "#C5CCBB" }
    },
    {
      "name": "Object keys (JSON, YAML)",
      "scope": [
        "support.type.property-name",
        "string.quoted.double.json support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": { "foreground": "#7CC0E3" }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": { "foreground": "#C5CCBB" }
    },
    {
      "name": "Built-in / language variables (this, self, super)",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": { "foreground": "#BE94D8", "fontStyle": "italic" }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "tag.decorator"
      ],
      "settings": { "foreground": "#7DD8B6" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": { "foreground": "#9DA296" }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "constant.character.escape.regexp"
      ],
      "settings": { "foreground": "#59B2B5" }
    },
    {
      "name": "HTML/JSX tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag",
        "meta.tag.attributes"
      ],
      "settings": { "foreground": "#E66F62" }
    },
    {
      "name": "HTML/JSX attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": { "foreground": "#7DD8B6", "fontStyle": "italic" }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": { "foreground": "#E66F62" }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": { "foreground": "#7CC0E3" }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value.css",
        "constant.numeric.css",
        "support.constant.color"
      ],
      "settings": { "foreground": "#E5B568" }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": { "foreground": "#BE94D8", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold.markdown"
      ],
      "settings": { "foreground": "#D9DFD1", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic.markdown"
      ],
      "settings": { "foreground": "#D9DFD1", "fontStyle": "italic" }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title.markdown",
        "constant.other.reference.link.markdown"
      ],
      "settings": { "foreground": "#7CC0E3", "fontStyle": "underline" }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": { "foreground": "#BCC270" }
    },
    {
      "name": "Markdown lists",
      "scope": [
        "markup.list",
        "punctuation.definition.list.begin"
      ],
      "settings": { "foreground": "#E5B568" }
    },
    {
      "name": "Markdown quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": { "foreground": "#789292", "fontStyle": "italic" }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted"
      ],
      "settings": { "foreground": "#BCC270" }
    },
    {
      "name": "Diff removed",
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted"
      ],
      "settings": { "foreground": "#E66F62" }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": { "foreground": "#E8D579" }
    },
    {
      "name": "Invalid / illegal",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": { "foreground": "#E66F62", "fontStyle": "underline" }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": { "foreground": "#9DA296", "fontStyle": "strikethrough" }
    }
  ],

  "semanticTokenColors": {
    "type":      "#7DD8B6",
    "class":     "#7DD8B6",
    "interface": "#7DD8B6",
    "enum":      "#7DD8B6",
    "struct":    "#7DD8B6",
    "typeParameter": { "foreground": "#7DD8B6", "italic": true },

    "namespace": "#7CC0E3",
    "function":  "#7CC0E3",
    "method":    "#7CC0E3",
    "macro":     "#BE94D8",

    "property":   "#C5CCBB",
    "variable":   "#C5CCBB",
    "parameter":  { "foreground": "#C5CCBB", "italic": true },
    "enumMember": "#E5B568",

    "keyword":  "#BE94D8",
    "operator": "#9DA296",
    "comment":  { "foreground": "#789292", "italic": true },
    "string":   "#BCC270",
    "number":   "#E5B568",
    "regexp":   "#59B2B5",

    "*.declaration":  { "bold": true },
    "*.deprecated":   { "strikethrough": true },
    "*.readonly":     "#E5B568"
  }
}
