  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": { "foreground": "#878787", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": { "foreground": "#E9C87E" }
    },
    {
      "name": "String escape sequences",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": { "foreground": "#E1A583" }
    },
    {
      "name": "Numbers, booleans, null",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": { "foreground": "#E1A583" }
    },
    {
      "name": "Constants",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember",
        "constant.other"
      ],
      "settings": { "foreground": "#E1A583" }
    },
    {
      "name": "Keywords (control flow, async/await, return)",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.expression",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.logical",
        "keyword.operator.ternary"
      ],
      "settings": { "foreground": "#C38DC6" }
    },
    {
      "name": "Storage (const, let, function, class, async)",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#C38DC6" }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison"
      ],
      "settings": { "foreground": "#A1A09C" }
    },
    {
      "name": "Types",
      "scope": [
        "support.type",
        "entity.name.type",
        "entity.other.inherited-class",
        "meta.type.annotation entity.name.type"
      ],
      "settings": { "foreground": "#89C8B6" }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.class",
        "entity.name.namespace",
        "support.class"
      ],
      "settings": { "foreground": "#89C8B6" }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.method.declaration entity.name.function"
      ],
      "settings": { "foreground": "#85B0E1" }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": { "foreground": "#CAC9C4", "fontStyle": "italic" }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.property-name"
      ],
      "settings": { "foreground": "#CAC9C4" }
    },
    {
      "name": "Object keys (JSON, YAML)",
      "scope": [
        "support.type.property-name",
        "string.quoted.double.json support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": { "foreground": "#85B0E1" }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": { "foreground": "#CAC9C4" }
    },
    {
      "name": "Built-in / language variables (this, self, super)",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": { "foreground": "#C38DC6", "fontStyle": "italic" }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "tag.decorator"
      ],
      "settings": { "foreground": "#89C8B6" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": { "foreground": "#A1A09C" }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "constant.character.escape.regexp"
      ],
      "settings": { "foreground": "#71AAAD" }
    },
    {
      "name": "HTML/JSX tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag",
        "meta.tag.attributes"
      ],
      "settings": { "foreground": "#EF678B" }
    },
    {
      "name": "HTML/JSX attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": { "foreground": "#89C8B6", "fontStyle": "italic" }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": { "foreground": "#EF678B" }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": { "foreground": "#85B0E1" }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value.css",
        "constant.numeric.css",
        "support.constant.color"
      ],
      "settings": { "foreground": "#E1A583" }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": { "foreground": "#C38DC6", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold.markdown"
      ],
      "settings": { "foreground": "#DDDCD8", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic.markdown"
      ],
      "settings": { "foreground": "#DDDCD8", "fontStyle": "italic" }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title.markdown",
        "constant.other.reference.link.markdown"
      ],
      "settings": { "foreground": "#85B0E1", "fontStyle": "underline" }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": { "foreground": "#E9C87E" }
    },
    {
      "name": "Markdown lists",
      "scope": [
        "markup.list",
        "punctuation.definition.list.begin"
      ],
      "settings": { "foreground": "#E1A583" }
    },
    {
      "name": "Markdown quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": { "foreground": "#878787", "fontStyle": "italic" }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted"
      ],
      "settings": { "foreground": "#8BC392" }
    },
    {
      "name": "Diff removed",
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted"
      ],
      "settings": { "foreground": "#EF678B" }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": { "foreground": "#E9C87E" }
    },
    {
      "name": "Invalid / illegal",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": { "foreground": "#EF678B", "fontStyle": "underline" }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": { "foreground": "#A1A09C", "fontStyle": "strikethrough" }
    }
  ],

  "semanticTokenColors": {
    "type":      "#89C8B6",
    "class":     "#89C8B6",
    "interface": "#89C8B6",
    "enum":      "#89C8B6",
    "struct":    "#89C8B6",
    "typeParameter": { "foreground": "#89C8B6", "italic": true },

    "namespace": "#85B0E1",
    "function":  "#85B0E1",
    "method":    "#85B0E1",
    "macro":     "#C38DC6",

    "property":   "#CAC9C4",
    "variable":   "#CAC9C4",
    "parameter":  { "foreground": "#CAC9C4", "italic": true },
    "enumMember": "#E1A583",

    "keyword":  "#C38DC6",
    "operator": "#A1A09C",
    "comment":  { "foreground": "#878787", "italic": true },
    "string":   "#E9C87E",
    "number":   "#E1A583",
    "regexp":   "#71AAAD",

    "*.declaration":  { "bold": true },
    "*.deprecated":   { "strikethrough": true },
    "*.readonly":     "#E1A583"
  }
}
