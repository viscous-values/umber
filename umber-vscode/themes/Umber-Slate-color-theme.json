  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": { "foreground": "#A8BDD6", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": { "foreground": "#98C379" }
    },
    {
      "name": "String escape sequences",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": { "foreground": "#D19A66" }
    },
    {
      "name": "Numbers, booleans, null",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": { "foreground": "#D19A66" }
    },
    {
      "name": "Constants",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember",
        "constant.other"
      ],
      "settings": { "foreground": "#D19A66" }
    },
    {
      "name": "Keywords (control flow, async/await, return)",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.expression",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.logical",
        "keyword.operator.ternary"
      ],
      "settings": { "foreground": "#C586B0" }
    },
    {
      "name": "Storage (const, let, function, class, async)",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#C586B0" }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison"
      ],
      "settings": { "foreground": "#A39A8E" }
    },
    {
      "name": "Types",
      "scope": [
        "support.type",
        "entity.name.type",
        "entity.other.inherited-class",
        "meta.type.annotation entity.name.type"
      ],
      "settings": { "foreground": "#E5C07B" }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.class",
        "entity.name.namespace",
        "support.class"
      ],
      "settings": { "foreground": "#E5C07B" }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.method.declaration entity.name.function"
      ],
      "settings": { "foreground": "#88A6C5" }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": { "foreground": "#CFBC98", "fontStyle": "italic" }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.property-name"
      ],
      "settings": { "foreground": "#CFBC98" }
    },
    {
      "name": "Object keys (JSON, YAML)",
      "scope": [
        "support.type.property-name",
        "string.quoted.double.json support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": { "foreground": "#88A6C5" }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": { "foreground": "#CFBC98" }
    },
    {
      "name": "Built-in / language variables (this, self, super)",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": { "foreground": "#C586B0", "fontStyle": "italic" }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "tag.decorator"
      ],
      "settings": { "foreground": "#E5C07B" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": { "foreground": "#A39A8E" }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "constant.character.escape.regexp"
      ],
      "settings": { "foreground": "#7AA8AC" }
    },
    {
      "name": "HTML/JSX tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag",
        "meta.tag.attributes"
      ],
      "settings": { "foreground": "#E06C75" }
    },
    {
      "name": "HTML/JSX attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": { "foreground": "#E5C07B", "fontStyle": "italic" }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": { "foreground": "#E06C75" }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": { "foreground": "#88A6C5" }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value.css",
        "constant.numeric.css",
        "support.constant.color"
      ],
      "settings": { "foreground": "#D19A66" }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": { "foreground": "#C586B0", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold.markdown"
      ],
      "settings": { "foreground": "#D8CDB2", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic.markdown"
      ],
      "settings": { "foreground": "#D8CDB2", "fontStyle": "italic" }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title.markdown",
        "constant.other.reference.link.markdown"
      ],
      "settings": { "foreground": "#88A6C5", "fontStyle": "underline" }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": { "foreground": "#98C379" }
    },
    {
      "name": "Markdown lists",
      "scope": [
        "markup.list",
        "punctuation.definition.list.begin"
      ],
      "settings": { "foreground": "#D19A66" }
    },
    {
      "name": "Markdown quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": { "foreground": "#A8BDD6", "fontStyle": "italic" }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted"
      ],
      "settings": { "foreground": "#98C379" }
    },
    {
      "name": "Diff removed",
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted"
      ],
      "settings": { "foreground": "#E06C75" }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": { "foreground": "#E5C07B" }
    },
    {
      "name": "Invalid / illegal",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": { "foreground": "#E06C75", "fontStyle": "underline" }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": { "foreground": "#A39A8E", "fontStyle": "strikethrough" }
    }
  ],

  "semanticTokenColors": {
    "type":      "#E5C07B",
    "class":     "#E5C07B",
    "interface": "#E5C07B",
    "enum":      "#E5C07B",
    "struct":    "#E5C07B",
    "typeParameter": { "foreground": "#E5C07B", "italic": true },

    "namespace": "#88A6C5",
    "function":  "#88A6C5",
    "method":    "#88A6C5",
    "macro":     "#C586B0",

    "property":   "#CFBC98",
    "variable":   "#CFBC98",
    "parameter":  { "foreground": "#CFBC98", "italic": true },
    "enumMember": "#D19A66",

    "keyword":  "#C586B0",
    "operator": "#A39A8E",
    "comment":  { "foreground": "#A8BDD6", "italic": true },
    "string":   "#98C379",
    "number":   "#D19A66",
    "regexp":   "#7AA8AC",

    "*.declaration":  { "bold": true },
    "*.deprecated":   { "strikethrough": true },
    "*.readonly":     "#D19A66"
  }
}
