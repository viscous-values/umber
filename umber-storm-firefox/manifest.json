{
  "manifest_version": 2,
  "name": "Umber Storm",
  "version": "1.0.0",
  "description": "Umber palette family — Umber Storm (Firefox theme).",
  "author": "Tyler",
  "homepage_url": "https://github.com/tyler872010/umber",

  "browser_specific_settings": {
    "gecko": {
      "id": "umber-storm@tyler"
    }
  },

  "theme": {
    "colors": {
      "frame":               "#1F2530",
      "frame_inactive":      "#262C36",

      "toolbar":             "#262C36",
      "toolbar_top_separator":    "#2E343E",
      "toolbar_bottom_separator": "#2E343E",
      "toolbar_vertical_separator": "#2E343E",

      "toolbar_field":            "#2E343E",
      "toolbar_field_text":       "#E8E5DC",
      "toolbar_field_border":     "#40454D",
      "toolbar_field_focus":      "#3A3A3A",
      "toolbar_field_text_focus": "#D4CCB9",
      "toolbar_field_border_focus": "#CCBC9D",
      "toolbar_field_highlight":  "#CCBC9D",
      "toolbar_field_highlight_text": "#1F2530",

      "tab_text":                "#D4CCB9",
      "tab_loading":             "#CCBC9D",
      "tab_line":                "#CCBC9D",
      "tab_selected":            "#2E343E",
      "tab_background_text":     "#9D9A96",
      "tab_background_separator": "#2E343E",

      "bookmark_text":           "#D4CCB9",

      "icons":                   "#9D9A96",
      "icons_attention":         "#E5C07B",

      "popup":                   "#262C36",
      "popup_text":              "#E8E5DC",
      "popup_border":            "#40454D",
      "popup_highlight":         "#2E343E",
      "popup_highlight_text":    "#D4CCB9",

      "sidebar":                 "#262C36",
      "sidebar_text":            "#E8E5DC",
      "sidebar_border":          "#2E343E",
      "sidebar_highlight":       "#3A3A3A",
      "sidebar_highlight_text":  "#D4CCB9",

      "button_background_hover":  "#2E343E",
      "button_background_active": "#40454D",

      "ntp_background":          "#1F2530",
      "ntp_text":                "#D4CCB9",
      "ntp_card_background":     "#262C36",

      "address_bar_box_text":    "#E8E5DC",
      "address_bar_box_focus":   "#3A3A3A",

      "tab_attention":           "#E5C07B"
    },
    "properties": {
      "color_scheme":          "dark",
      "content_color_scheme":  "system"
    }
  }
}
