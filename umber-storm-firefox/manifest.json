{
  "manifest_version": 2,
  "name": "Umber Storm",
  "version": "1.0.1",
  "description": "Umber palette family — Umber Storm (Firefox theme).",
  "author": "viscous-values",
  "homepage_url": "https://github.com/viscous-values/umber",

  "browser_specific_settings": {
    "gecko": {
      "id": "umber-storm@viscous-values"
    }
  },

  "icons": {
    "48":  "icons/icon-48.png",
    "96":  "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "theme": {
    "colors": {
      "frame":               "#1A1939",
      "frame_inactive":      "#232342",

      "toolbar":             "#232342",
      "toolbar_top_separator":    "#2C2D4C",
      "toolbar_bottom_separator": "#2C2D4C",
      "toolbar_vertical_separator": "#2C2D4C",

      "toolbar_field":            "#2C2D4C",
      "toolbar_field_text":       "#EAEEF9",
      "toolbar_field_border":     "#6E708D",
      "toolbar_field_focus":      "#43445F",
      "toolbar_field_text_focus": "#D5DCEF",
      "toolbar_field_border_focus": "#EBDE77",
      "toolbar_field_highlight":  "#E8CA8D",
      "toolbar_field_highlight_text": "#1D1E33",

      "tab_text":                "#D5DCEF",
      "tab_loading":             "#EBDE77",
      "tab_line":                "#EBDE77",
      "tab_selected":            "#2C2D4C",
      "tab_background_text":     "#99A0B1",
      "tab_background_separator": "#2C2D4C",

      "bookmark_text":           "#D5DCEF",

      "icons":                   "#99A0B1",
      "icons_attention":         "#FBA541",

      "popup":                   "#232342",
      "popup_text":              "#EAEEF9",
      "popup_border":            "#43445F",
      "popup_highlight":         "#2C2D4C",
      "popup_highlight_text":    "#D5DCEF",

      "sidebar":                 "#232342",
      "sidebar_text":            "#EAEEF9",
      "sidebar_border":          "#2C2D4C",
      "sidebar_highlight":       "#E8CA8D",
      "sidebar_highlight_text":  "#1D1E33",

      "button_background_hover":  "#2C2D4C",
      "button_background_active": "#43445F",

      "ntp_background":          "#1A1939",
      "ntp_text":                "#D5DCEF",
      "ntp_card_background":     "#232342",

      "address_bar_box_text":    "#EAEEF9",
      "address_bar_box_focus":   "#43445F",

      "tab_attention":           "#FBA541"
    },
    "properties": {
      "color_scheme":          "dark",
      "content_color_scheme":  "system"
    }
  }
}
