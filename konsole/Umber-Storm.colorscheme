# Spark accent hexes adapted from Atom One Dark.

[General]
Description=Umber Storm
Opacity=1
Wallpaper=
Anchor=0.5,0.5
Blur=false
ColorRandomization=false
FillStyle=Tile
WallpaperFlipType=NoFlip
WallpaperOpacity=1

[Background]
Color=26,25,57
[BackgroundFaint]
Color=26,25,57
[BackgroundIntense]
Color=26,25,57

[Foreground]
Color=191,201,224
[ForegroundFaint]
Color=153,160,177
[ForegroundIntense]
Color=234,238,249

# 0 — black (role.ansi.black; intense = role.ansi.bright_black)
[Color0]
Color=73,74,113
[Color0Faint]
Color=35,35,66
[Color0Intense]
Color=153,160,177

# 1 — red (role.ansi.red)
[Color1]
Color=236,103,113
[Color1Faint]
Color=157,71,76
[Color1Intense]
Color=255,130,137

