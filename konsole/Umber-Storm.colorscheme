# Spark accent hexes adapted from Atom One Dark.

[General]
Description=Umber Storm
Opacity=1
Wallpaper=
Anchor=0.5,0.5
Blur=false
ColorRandomization=false
FillStyle=Tile
WallpaperFlipType=NoFlip
WallpaperOpacity=1

[Background]
Color=31,37,48
[BackgroundFaint]
Color=31,37,48
[BackgroundIntense]
Color=31,37,48

[Foreground]
Color=204,188,157
[ForegroundFaint]
Color=157,154,150
[ForegroundIntense]
Color=232,229,220

# 0 — black (role.ansi.black; intense = role.ansi.bright_black)
[Color0]
Color=38,44,54
[Color0Faint]
Color=38,44,54
[Color0Intense]
Color=157,154,150

# 1 — red (role.ansi.red)
[Color1]
