# Umber — Konsole 16-ANSI color scheme
# Part of the Umber theme suite — https://github.com/viscous-values/umber
# Copyright (C) 2026 viscous-values — GPL-3.0-or-later
# Spark accent hexes adapted from Atom One Dark.

[General]
Description=Umber Slate
Opacity=1
Wallpaper=
Anchor=0.5,0.5
Blur=false
ColorRandomization=false
FillStyle=Tile
WallpaperFlipType=NoFlip
WallpaperOpacity=1

[Background]
Color=19,32,41
[BackgroundFaint]
Color=19,32,41
[BackgroundIntense]
Color=19,32,41

[Foreground]
Color=198,202,203
[ForegroundFaint]
Color=157,160,162
[ForegroundIntense]
Color=236,239,240

# 0 — black (role.ansi.black; intense = role.ansi.bright_black)
[Color0]
Color=63,81,93
[Color0Faint]
Color=27,41,50
[Color0Intense]
Color=157,160,162

# 1 — red (role.ansi.red)
[Color1]
Color=223,115,114
[Color1Faint]
Color=149,78,77
[Color1Intense]
Color=252,134,132

# 2 — green (role.ansi.green)
[Color2]
Color=103,190,169
[Color2Faint]
Color=76,132,118
[Color2Intense]
Color=116,214,190

# 3 — yellow (role.ansi.yellow)
[Color3]
Color=242,208,125
[Color3Faint]
Color=178,156,102
[Color3Intense]
Color=255,233,181

# 4 — blue (role.ansi.blue)
[Color4]
Color=128,176,231
[Color4Faint]
Color=92,124,159
[Color4Intense]
Color=149,199,255

# 5 — magenta (role.ansi.magenta)
[Color5]
Color=200,146,202
[Color5Faint]
Color=138,102,139
[Color5Intense]
Color=226,165,229

# 6 — cyan (role.ansi.cyan)
[Color6]
Color=114,208,208
[Color6Faint]
Color=89,149,149
[Color6Intense]
Color=125,233,232

# 7 — white / default text (role.ansi.white)
[Color7]
Color=198,202,203
[Color7Faint]
Color=157,160,162
[Color7Intense]
Color=236,239,240
