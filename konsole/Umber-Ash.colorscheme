# Umber — Konsole 16-ANSI color scheme
# Part of the Umber theme suite — https://github.com/viscous-values/umber
# Copyright (C) 2026 Tyler — GPL-3.0-or-later
# Spark accent hexes adapted from Atom One Dark.

[General]
Description=Umber Ash
Opacity=1
Wallpaper=
Anchor=0.5,0.5
Blur=false
ColorRandomization=false
FillStyle=Tile
WallpaperFlipType=NoFlip
WallpaperOpacity=1

[Background]
Color=30,30,30
[BackgroundFaint]
Color=30,30,30
[BackgroundIntense]
Color=30,30,30

[Foreground]
Color=202,201,196
[ForegroundFaint]
Color=161,160,156
[ForegroundIntense]
Color=239,238,235

# 0 — black (role.ansi.black; intense = role.ansi.bright_black)
[Color0]
Color=81,77,78
[Color0Faint]
Color=39,39,39
[Color0Intense]
Color=161,160,156

# 1 — red (role.ansi.red)
[Color1]
Color=239,103,139
[Color1Faint]
Color=160,72,94
[Color1Intense]
Color=255,133,162

# 2 — green (role.ansi.green)
[Color2]
Color=139,195,146
[Color2Faint]
Color=101,137,106
[Color2Intense]
Color=156,219,164

# 3 — yellow (role.ansi.yellow)
[Color3]
Color=233,200,126
[Color3Faint]
Color=170,148,100
[Color3Intense]
Color=255,223,153

# 4 — blue (role.ansi.blue)
[Color4]
Color=128,176,231
[Color4Faint]
Color=92,124,159
[Color4Intense]
Color=149,199,255

# 5 — magenta (role.ansi.magenta)
[Color5]
Color=195,141,198
[Color5Faint]
Color=133,98,135
[Color5Intense]
Color=221,160,224

# 6 — cyan (role.ansi.cyan)
[Color6]
Color=114,208,208
[Color6Faint]
Color=89,149,149
[Color6Intense]
Color=125,233,232

# 7 — white / default text (role.ansi.white)
[Color7]
Color=202,201,196
[Color7Faint]
Color=161,160,156
[Color7Intense]
Color=239,238,235
