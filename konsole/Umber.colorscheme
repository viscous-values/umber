# Umber — Konsole 16-ANSI color scheme
# Part of the Umber theme suite — https://github.com/viscous-values/umber
# Copyright (C) 2026 Tyler — GPL-3.0-or-later
# Spark accent hexes adapted from Atom One Dark.

[General]
Description=Umber
Opacity=1
Wallpaper=
Anchor=0.5,0.5
Blur=false
ColorRandomization=false
FillStyle=Tile
WallpaperFlipType=NoFlip
WallpaperOpacity=1

[Background]
Color=41,27,14
[BackgroundFaint]
Color=41,27,14
[BackgroundIntense]
Color=41,27,14

[Foreground]
Color=217,198,168
[ForegroundFaint]
Color=170,158,139
[ForegroundIntense]
Color=247,237,221

# 0 — black (role.ansi.black; intense = role.ansi.bright_black)
[Color0]
Color=93,74,58
[Color0Faint]
Color=50,36,23
[Color0Intense]
Color=170,158,139

