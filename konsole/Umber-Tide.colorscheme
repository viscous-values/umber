# Spark accent hexes adapted from Atom One Dark.

[General]
Description=Umber Tide
Opacity=1
Wallpaper=
Anchor=0.5,0.5
Blur=false
ColorRandomization=false
FillStyle=Tile
WallpaperFlipType=NoFlip
WallpaperOpacity=1

[Background]
Color=9,35,33
[BackgroundFaint]
Color=9,35,33
[BackgroundIntense]
Color=9,35,33

[Foreground]
Color=197,204,187
[ForegroundFaint]
Color=157,162,150
[ForegroundIntense]
Color=236,240,231

# 0 — black (role.ansi.black; intense = role.ansi.bright_black)
[Color0]
Color=54,85,83
[Color0Faint]
Color=18,44,42
[Color0Intense]
Color=157,162,150

# 1 — red (role.ansi.red)
[Color1]
Color=230,111,98
[Color1Faint]
Color=153,76,67
[Color1Intense]
Color=255,133,119

