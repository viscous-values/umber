{
  "manifest_version": 2,
  "name": "Umber Ash",
  "version": "1.0.1",
  "description": "Umber palette family — Umber Ash (Firefox theme).",
  "author": "viscous-values",
  "homepage_url": "https://github.com/viscous-values/umber",

  "browser_specific_settings": {
    "gecko": {
      "id": "umber-ash@viscous-values"
    }
  },

  "icons": {
    "48":  "icons/icon-48.png",
    "96":  "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "theme": {
    "colors": {
      "frame":               "#1E1E1E",
      "frame_inactive":      "#272727",

      "toolbar":             "#272727",
      "toolbar_top_separator":    "#313131",
      "toolbar_bottom_separator": "#313131",
      "toolbar_vertical_separator": "#313131",

      "toolbar_field":            "#313131",
      "toolbar_field_text":       "#EFEEEB",
      "toolbar_field_border":     "#737373",
      "toolbar_field_focus":      "#474747",
      "toolbar_field_text_focus": "#DDDCD8",
      "toolbar_field_border_focus": "#BD7564",
      "toolbar_field_highlight":  "#C3C8CE",
      "toolbar_field_highlight_text": "#1D2125",

      "tab_text":                "#DDDCD8",
      "tab_loading":             "#BD7564",
      "tab_line":                "#BD7564",
      "tab_selected":            "#313131",
      "tab_background_text":     "#A1A09C",
      "tab_background_separator": "#313131",

      "bookmark_text":           "#DDDCD8",

      "icons":                   "#A1A09C",
      "icons_attention":         "#E9C87E",

      "popup":                   "#272727",
      "popup_text":              "#EFEEEB",
      "popup_border":            "#474747",
      "popup_highlight":         "#313131",
      "popup_highlight_text":    "#DDDCD8",

      "sidebar":                 "#272727",
      "sidebar_text":            "#EFEEEB",
      "sidebar_border":          "#313131",
      "sidebar_highlight":       "#C3C8CE",
      "sidebar_highlight_text":  "#1D2125",

      "button_background_hover":  "#313131",
      "button_background_active": "#474747",

      "ntp_background":          "#1E1E1E",
      "ntp_text":                "#DDDCD8",
      "ntp_card_background":     "#272727",

      "address_bar_box_text":    "#EFEEEB",
      "address_bar_box_focus":   "#474747",

      "tab_attention":           "#E9C87E"
    },
    "properties": {
      "color_scheme":          "dark",
      "content_color_scheme":  "system"
    }
  }
}
