{
  "manifest_version": 3,
  "name": "Umber Storm",
  "version": "2.0.0",
  "description": "Umber palette family — Umber Storm (Chromium/Chrome theme).",
  "author": "viscous-values",
  "homepage_url": "https://github.com/viscous-values/umber",

  "icons": {
    "48":  "icons/icon-48.png",
    "96":  "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "theme": {
    "colors": {
      "frame":                          [26, 25, 57],
      "frame_inactive":                 [35, 35, 66],
      "frame_incognito":                [26, 25, 57],
      "frame_incognito_inactive":       [35, 35, 66],

      "toolbar":                        [35, 35, 66],
      "toolbar_text":                   [234, 238, 249],
      "toolbar_button_icon":            [153, 160, 177],
      "omnibox_background":             [44, 45, 76],
      "omnibox_text":                   [234, 238, 249],

      "tab_text":                       [213, 220, 239],
      "tab_background_text":            [153, 160, 177],
      "tab_background_text_inactive":   [153, 160, 177],
      "background_tab":                 [35, 35, 66],
      "background_tab_inactive":        [35, 35, 66],

      "bookmark_text":                  [213, 220, 239],
      "ntp_background":                 [26, 25, 57],
      "ntp_text":                       [213, 220, 239],
      "ntp_link":                       [85, 198, 244],
      "ntp_header":                     [213, 220, 239],

      "control_background":             [44, 45, 76],
      "button_background":              [44, 45, 76]
    },
    "tints": {
      "buttons":      [-1, -1, 0.78],
      "frame":        [-1, -1, -1],
      "background_tab": [-1, -1, -1]
    },
    "properties": {
      "ntp_background_alignment": "center",
      "ntp_logo_alternate":       1
    }
  }
}
