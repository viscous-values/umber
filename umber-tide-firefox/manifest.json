{
  "manifest_version": 2,
  "name": "Umber Tide",
  "version": "1.0.1",
  "description": "Umber palette family — Umber Tide (Firefox theme).",
  "author": "viscous-values",
  "homepage_url": "https://github.com/viscous-values/umber",

  "browser_specific_settings": {
    "gecko": {
      "id": "umber-tide@viscous-values"
    }
  },

  "icons": {
    "48":  "icons/icon-48.png",
    "96":  "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "theme": {
    "colors": {
      "frame":               "#092321",
      "frame_inactive":      "#122C2A",

      "toolbar":             "#122C2A",
      "toolbar_top_separator":    "#1C3634",
      "toolbar_bottom_separator": "#1C3634",
      "toolbar_vertical_separator": "#1C3634",

      "toolbar_field":            "#1C3634",
      "toolbar_field_text":       "#ECF0E7",
      "toolbar_field_border":     "#617876",
      "toolbar_field_focus":      "#364C4A",
      "toolbar_field_text_focus": "#D9DFD1",
      "toolbar_field_border_focus": "#FA9BAC",
      "toolbar_field_highlight":  "#ECBCC2",
      "toolbar_field_highlight_text": "#022625",

      "tab_text":                "#D9DFD1",
      "tab_loading":             "#FA9BAC",
      "tab_line":                "#FA9BAC",
      "tab_selected":            "#1C3634",
      "tab_background_text":     "#9DA296",
      "tab_background_separator": "#1C3634",

      "bookmark_text":           "#D9DFD1",

      "icons":                   "#9DA296",
      "icons_attention":         "#E8D579",

      "popup":                   "#122C2A",
      "popup_text":              "#ECF0E7",
      "popup_border":            "#364C4A",
      "popup_highlight":         "#1C3634",
      "popup_highlight_text":    "#D9DFD1",

      "sidebar":                 "#122C2A",
      "sidebar_text":            "#ECF0E7",
      "sidebar_border":          "#1C3634",
      "sidebar_highlight":       "#ECBCC2",
      "sidebar_highlight_text":  "#022625",

      "button_background_hover":  "#1C3634",
      "button_background_active": "#364C4A",

      "ntp_background":          "#092321",
      "ntp_text":                "#D9DFD1",
      "ntp_card_background":     "#122C2A",

      "address_bar_box_text":    "#ECF0E7",
      "address_bar_box_focus":   "#364C4A",

      "tab_attention":           "#E8D579"
    },
    "properties": {
      "color_scheme":          "dark",
      "content_color_scheme":  "system"
    }
  }
}
