{
  "manifest_version": 2,
  "name": "Umber Tide",
  "version": "1.0.1",
  "description": "Umber palette family — Umber Tide (Firefox theme).",
  "author": "viscous-values",
  "homepage_url": "https://github.com/viscous-values/umber",

  "browser_specific_settings": {
    "gecko": {
      "id": "umber-tide@tyler"
    }
  },

  "icons": {
    "48":  "icons/icon-48.png",
    "96":  "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "theme": {
    "colors": {
      "frame":               "#202629",
      "frame_inactive":      "#272D31",

      "toolbar":             "#272D31",
      "toolbar_top_separator":    "#2F3539",
      "toolbar_bottom_separator": "#2F3539",
      "toolbar_vertical_separator": "#2F3539",

      "toolbar_field":            "#2F3539",
      "toolbar_field_text":       "#EAE5D9",
      "toolbar_field_border":     "#404648",
      "toolbar_field_focus":      "#404648",
      "toolbar_field_text_focus": "#D6CCB5",
      "toolbar_field_border_focus": "#7AA8AC",
      "toolbar_field_highlight":  "#7AA8AC",
      "toolbar_field_highlight_text": "#202629",

      "tab_text":                "#D6CCB5",
      "tab_loading":             "#7AA8AC",
      "tab_line":                "#7AA8AC",
      "tab_selected":            "#2F3539",
      "tab_background_text":     "#A09A93",
      "tab_background_separator": "#2F3539",

      "bookmark_text":           "#D6CCB5",

      "icons":                   "#A09A93",
      "icons_attention":         "#E5C07B",

      "popup":                   "#272D31",
      "popup_text":              "#EAE5D9",
      "popup_border":            "#404648",
      "popup_highlight":         "#2F3539",
      "popup_highlight_text":    "#D6CCB5",

      "sidebar":                 "#272D31",
      "sidebar_text":            "#EAE5D9",
      "sidebar_border":          "#2F3539",
      "sidebar_highlight":       "#7AA8AC",
      "sidebar_highlight_text":  "#202629",

      "button_background_hover":  "#2F3539",
      "button_background_active": "#404648",

      "ntp_background":          "#202629",
      "ntp_text":                "#D6CCB5",
      "ntp_card_background":     "#272D31",

      "address_bar_box_text":    "#EAE5D9",
      "address_bar_box_focus":   "#404648",

      "tab_attention":           "#E5C07B"
    },
    "properties": {
      "color_scheme":          "dark",
      "content_color_scheme":  "system"
    }
  }
}
