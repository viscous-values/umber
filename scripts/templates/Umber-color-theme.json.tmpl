    "list.inactiveSelectionBackground": "{{ role.bg_active }}",
    "list.inactiveSelectionForeground": "{{ role.fg_emphasis }}",
    "list.hoverBackground": "{{ role.bg_raised }}",
    "list.hoverForeground": "{{ role.fg }}",
    "list.focusBackground": "{{ role.bg_active }}",
    "list.focusForeground": "{{ role.fg_emphasis }}",
    "list.highlightForeground": "{{ role.interactive }}",
    "list.errorForeground": "{{ role.error }}",
    "list.warningForeground": "{{ role.warning }}",
    "list.dropBackground": "{{ role.interactive | rgba 33 }}",

    "tree.indentGuidesStroke": "{{ role.border }}",
    "tree.inactiveIndentGuidesStroke": "{{ role.separator }}",

    "statusBar.background": "{{ role.bg_raised }}",
    "statusBar.foreground": "{{ role.fg }}",
    "statusBar.border": "{{ role.divider }}",
    "statusBar.debuggingBackground": "{{ role.debug }}",
    "statusBar.debuggingForeground": "{{ role.fg_on_accent }}",
    "statusBar.noFolderBackground": "{{ role.bg_panel }}",
    "statusBarItem.activeBackground": "{{ role.bg_active }}",
    "statusBarItem.hoverBackground": "{{ role.bg_active }}",
    "statusBarItem.prominentBackground": "{{ role.bg_active }}",
    "statusBarItem.remoteBackground": "{{ role.interactive }}",
    "statusBarItem.remoteForeground": "{{ role.fg_on_accent }}",
    "statusBarItem.errorBackground": "{{ role.error }}",
    "statusBarItem.errorForeground": "{{ role.fg_on_accent }}",
    "statusBarItem.warningBackground": "{{ role.warning }}",
    "statusBarItem.warningForeground": "{{ role.fg_on_accent }}",

    "titleBar.activeBackground": "{{ role.bg_raised }}",
    "titleBar.activeForeground": "{{ role.fg }}",
    "titleBar.inactiveBackground": "{{ role.bg_panel }}",
    "titleBar.inactiveForeground": "{{ role.fg_muted }}",
    "titleBar.border": "{{ role.divider }}",

    "menubar.selectionBackground": "{{ role.bg_active }}",
    "menubar.selectionForeground": "{{ role.fg_emphasis }}",
    "menu.background": "{{ role.bg_panel }}",
    "menu.foreground": "{{ role.fg }}",
    "menu.selectionBackground": "{{ role.selection_bg }}",
    "menu.selectionForeground": "{{ role.on_selection.fg }}",
    "menu.separatorBackground": "{{ role.border }}",

    "editorGroupHeader.tabsBackground": "{{ role.bg_panel }}",
    "editorGroupHeader.tabsBorder": "{{ role.divider }}",
    "editorGroup.border": "{{ role.divider }}",
    "tab.activeBackground": "{{ role.bg }}",
    "tab.activeForeground": "{{ role.fg_emphasis }}",
    "tab.activeBorderTop": "{{ role.accent }}",
    "tab.inactiveBackground": "{{ role.bg_panel }}",
    "tab.inactiveForeground": "{{ role.fg_muted }}",
    "tab.hoverBackground": "{{ role.bg_raised }}",
    "tab.border": "{{ role.divider }}",
    "tab.unfocusedActiveBorderTop": "{{ role.fg_muted }}",

    "breadcrumb.foreground": "{{ role.fg_muted }}",
    "breadcrumb.focusForeground": "{{ role.fg }}",
    "breadcrumb.activeSelectionForeground": "{{ role.fg_emphasis }}",
    "breadcrumb.background": "{{ role.bg }}",

    "panel.background": "{{ role.bg }}",
    "panel.border": "{{ role.divider }}",
    "panelTitle.activeBorder": "{{ role.accent }}",
    "panelTitle.activeForeground": "{{ role.fg_emphasis }}",
    "panelTitle.inactiveForeground": "{{ role.fg_muted }}",

    "button.background": "{{ role.button_bg }}",
    "button.foreground": "{{ role.fg_on_accent }}",
    "button.hoverBackground": "{{ role.button_hover }}",
    "button.secondaryBackground": "{{ role.bg_active }}",
    "button.secondaryForeground": "{{ role.fg }}",
    "button.secondaryHoverBackground": "{{ role.bg_active_hover }}",

    "checkbox.background": "{{ role.bg }}",
    "checkbox.foreground": "{{ role.fg }}",
    "checkbox.border": "{{ role.input_border }}",

    "input.background": "{{ role.bg }}",
    "input.foreground": "{{ role.fg }}",
    "input.border": "{{ role.input_border }}",
    "input.placeholderForeground": "{{ role.fg_muted }}",
    "inputOption.activeBackground": "{{ role.interactive | rgba 33 }}",
    "inputOption.activeBorder": "{{ role.interactive }}",
    "inputOption.activeForeground": "{{ role.fg_emphasis }}",
    "inputValidation.errorBackground": "{{ role.error | rgba 22 }}",
    "inputValidation.errorBorder": "{{ role.error }}",
    "inputValidation.warningBackground": "{{ role.warning | rgba 22 }}",
    "inputValidation.warningBorder": "{{ role.warning }}",
    "inputValidation.infoBackground": "{{ role.info | rgba 22 }}",
    "inputValidation.infoBorder": "{{ role.info }}",

    "dropdown.background": "{{ role.bg_panel }}",
    "dropdown.foreground": "{{ role.fg }}",
    "dropdown.border": "{{ role.input_border }}",
    "dropdown.listBackground": "{{ role.bg_panel }}",

    "badge.background": "{{ role.interactive }}",
    "badge.foreground": "{{ role.fg_on_accent }}",

    "scrollbar.shadow": "{{ role.shadow | rgba 80 }}",
    "scrollbarSlider.background": "{{ role.bg_active | rgba 66 }}",
    "scrollbarSlider.hoverBackground": "{{ role.bg_active_hover | rgba 88 }}",
    "scrollbarSlider.activeBackground": "{{ role.fg_muted | rgba AA }}",

    "progressBar.background": "{{ role.interactive }}",

    "notificationCenter.border": "{{ role.border }}",
    "notificationCenterHeader.background": "{{ role.bg_raised }}",
    "notificationCenterHeader.foreground": "{{ role.fg }}",
    "notifications.background": "{{ role.bg_panel }}",
    "notifications.foreground": "{{ role.fg }}",
    "notifications.border": "{{ role.border }}",
    "notificationsErrorIcon.foreground": "{{ role.error }}",
    "notificationsWarningIcon.foreground": "{{ role.warning }}",
    "notificationsInfoIcon.foreground": "{{ role.info }}",

    "gitDecoration.modifiedResourceForeground": "{{ role.diff_modified }}",
    "gitDecoration.deletedResourceForeground": "{{ role.diff_removed }}",
    "gitDecoration.untrackedResourceForeground": "{{ role.diff_added }}",
    "gitDecoration.ignoredResourceForeground": "{{ role.fg_muted }}",
    "gitDecoration.conflictingResourceForeground": "{{ role.error }}",
    "gitDecoration.submoduleResourceForeground": "{{ role.info }}",
    "gitDecoration.stageModifiedResourceForeground": "{{ role.diff_modified }}",
    "gitDecoration.stageDeletedResourceForeground": "{{ role.diff_removed }}",

    "terminal.background": "{{ role.ansi.bg }}",
    "terminal.foreground": "{{ role.ansi.fg }}",
    "terminal.selectionBackground": "{{ role.selection_bg | rgba 33 }}",
    "terminalCursor.foreground": "{{ role.ansi.cursor }}",
    "terminal.ansiBlack":         "{{ role.ansi.black }}",
    "terminal.ansiRed":           "{{ role.ansi.red }}",
    "terminal.ansiGreen":         "{{ role.ansi.green }}",
    "terminal.ansiYellow":        "{{ role.ansi.yellow }}",
    "terminal.ansiBlue":          "{{ role.ansi.blue }}",
    "terminal.ansiMagenta":       "{{ role.ansi.magenta }}",
    "terminal.ansiCyan":          "{{ role.ansi.cyan }}",
    "terminal.ansiWhite":         "{{ role.ansi.white }}",
    "terminal.ansiBrightBlack":   "{{ role.ansi.bright_black }}",
    "terminal.ansiBrightRed":     "{{ role.ansi.bright_red }}",
    "terminal.ansiBrightGreen":   "{{ role.ansi.bright_green }}",
    "terminal.ansiBrightYellow":  "{{ role.ansi.bright_yellow }}",
    "terminal.ansiBrightBlue":    "{{ role.ansi.bright_blue }}",
    "terminal.ansiBrightMagenta": "{{ role.ansi.bright_magenta }}",
    "terminal.ansiBrightCyan":    "{{ role.ansi.bright_cyan }}",
    "terminal.ansiBrightWhite":   "{{ role.ansi.bright_white }}",

    "debugToolBar.background": "{{ role.bg_raised }}",
    "debugIcon.breakpointForeground": "{{ role.error }}",
    "debugConsole.errorForeground": "{{ role.error }}",
    "debugConsole.warningForeground": "{{ role.warning }}",
    "debugConsole.infoForeground": "{{ role.info }}",
    "debugConsole.sourceForeground": "{{ role.fg_muted }}",

    "merge.currentHeaderBackground": "{{ role.info | rgba 66 }}",
    "merge.currentContentBackground": "{{ role.info | rgba 22 }}",
    "merge.incomingHeaderBackground": "{{ role.diff_added | rgba 66 }}",
    "merge.incomingContentBackground": "{{ role.diff_added | rgba 22 }}",
    "merge.commonHeaderBackground": "{{ role.fg_muted | rgba 66 }}",
    "merge.commonContentBackground": "{{ role.fg_muted | rgba 22 }}"
  },

  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": { "foreground": "{{ role.syntax.comment }}", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": { "foreground": "{{ role.syntax.string }}" }
    },
    {
      "name": "String escape sequences",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": { "foreground": "{{ role.syntax.escape }}" }
    },
    {
      "name": "Numbers, booleans, null",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": { "foreground": "{{ role.syntax.number }}" }
    },
    {
      "name": "Constants",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember",
        "constant.other"
      ],
      "settings": { "foreground": "{{ role.syntax.constant }}" }
    },
    {
      "name": "Keywords (control flow, async/await, return)",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.expression",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.logical",
        "keyword.operator.ternary"
      ],
      "settings": { "foreground": "{{ role.syntax.keyword }}" }
    },
    {
      "name": "Storage (const, let, function, class, async)",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "{{ role.syntax.storage }}" }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison"
      ],
      "settings": { "foreground": "{{ role.syntax.operator }}" }
    },
    {
      "name": "Types",
      "scope": [
        "support.type",
        "entity.name.type",
        "entity.other.inherited-class",
        "meta.type.annotation entity.name.type"
      ],
      "settings": { "foreground": "{{ role.syntax.type }}" }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.class",
        "entity.name.namespace",
        "support.class"
      ],
      "settings": { "foreground": "{{ role.syntax.class }}" }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.method.declaration entity.name.function"
      ],
      "settings": { "foreground": "{{ role.syntax.function }}" }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": { "foreground": "{{ role.syntax.parameter }}", "fontStyle": "italic" }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.property-name"
      ],
      "settings": { "foreground": "{{ role.syntax.property }}" }
    },
    {
      "name": "Object keys (JSON, YAML)",
      "scope": [
        "support.type.property-name",
        "string.quoted.double.json support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": { "foreground": "{{ role.syntax.key }}" }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": { "foreground": "{{ role.syntax.variable }}" }
    },
    {
      "name": "Built-in / language variables (this, self, super)",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": { "foreground": "{{ role.syntax.builtin }}", "fontStyle": "italic" }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "tag.decorator"
      ],
      "settings": { "foreground": "{{ role.syntax.decorator }}" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": { "foreground": "{{ role.syntax.punctuation }}" }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "constant.character.escape.regexp"
      ],
      "settings": { "foreground": "{{ role.syntax.regex }}" }
    },
    {
      "name": "HTML/JSX tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag",
        "meta.tag.attributes"
      ],
      "settings": { "foreground": "{{ role.syntax.tag }}" }
    },
    {
      "name": "HTML/JSX attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": { "foreground": "{{ role.syntax.attribute }}", "fontStyle": "italic" }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": { "foreground": "{{ role.syntax.tag }}" }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": { "foreground": "{{ role.syntax.key }}" }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value.css",
        "constant.numeric.css",
        "support.constant.color"
      ],
      "settings": { "foreground": "{{ role.syntax.constant }}" }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": { "foreground": "{{ role.syntax.heading }}", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold.markdown"
      ],
      "settings": { "foreground": "{{ role.syntax.emphasis }}", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic.markdown"
      ],
      "settings": { "foreground": "{{ role.syntax.emphasis }}", "fontStyle": "italic" }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title.markdown",
        "constant.other.reference.link.markdown"
      ],
      "settings": { "foreground": "{{ role.syntax.markup_link }}", "fontStyle": "underline" }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": { "foreground": "{{ role.syntax.markup_code }}" }
    },
    {
      "name": "Markdown lists",
      "scope": [
        "markup.list",
        "punctuation.definition.list.begin"
      ],
      "settings": { "foreground": "{{ role.syntax.markup_list }}" }
    },
    {
      "name": "Markdown quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": { "foreground": "{{ role.syntax.quote }}", "fontStyle": "italic" }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted"
      ],
      "settings": { "foreground": "{{ role.diff_added }}" }
    },
    {
      "name": "Diff removed",
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted"
      ],
      "settings": { "foreground": "{{ role.diff_removed }}" }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": { "foreground": "{{ role.diff_modified }}" }
    },
    {
      "name": "Invalid / illegal",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": { "foreground": "{{ role.syntax.invalid }}", "fontStyle": "underline" }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": { "foreground": "{{ role.syntax.deprecated }}", "fontStyle": "strikethrough" }
    }
  ],

  "semanticTokenColors": {
    "type":      "{{ role.syntax.type }}",
    "class":     "{{ role.syntax.class }}",
    "interface": "{{ role.syntax.type }}",
    "enum":      "{{ role.syntax.type }}",
    "struct":    "{{ role.syntax.type }}",
    "typeParameter": { "foreground": "{{ role.syntax.type }}", "italic": true },

    "namespace": "{{ role.syntax.namespace }}",
    "function":  "{{ role.syntax.function }}",
    "method":    "{{ role.syntax.function }}",
    "macro":     "{{ role.syntax.macro }}",

    "property":   "{{ role.syntax.property }}",
    "variable":   "{{ role.syntax.variable }}",
    "parameter":  { "foreground": "{{ role.syntax.parameter }}", "italic": true },
    "enumMember": "{{ role.syntax.constant }}",

    "keyword":  "{{ role.syntax.keyword }}",
    "operator": "{{ role.syntax.operator }}",
    "comment":  { "foreground": "{{ role.syntax.comment }}", "italic": true },
    "string":   "{{ role.syntax.string }}",
    "number":   "{{ role.syntax.number }}",
    "regexp":   "{{ role.syntax.regex }}",

    "*.declaration":  { "bold": true },
    "*.deprecated":   { "strikethrough": true },
    "*.readonly":     "{{ role.syntax.constant }}"
  }
}
