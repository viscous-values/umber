    "activityBar.inactiveForeground": "{{ role.fg_muted }}",
    "activityBar.border": "{{ role.divider }}",
    "activityBarBadge.background": "{{ role.interactive }}",
    "activityBarBadge.foreground": "{{ role.fg_on_accent }}",
    "activityBar.activeBorder": "{{ role.accent }}",

    "sideBar.background": "{{ role.bg_panel }}",
