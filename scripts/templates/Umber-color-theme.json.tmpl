{
  "name": "{{ var.name }}",
  "type": "dark",
  "semanticHighlighting": true,

  "_palette": {
    "hearth0": "{{ hearth.0 }}",
    "hearth1": "{{ hearth.1 }}",
    "hearth2": "{{ hearth.2 }}",
    "hearth3": "{{ hearth.3 }}",
    "glow0":   "{{ glow.0 }}",
    "glow1":   "{{ glow.1 }}",
    "glow2":   "{{ glow.2 }}",
    "glow3":   "{{ glow.3 }}",
    "mist0":   "{{ mist.0 }}",
    "mist1":   "{{ mist.1 }}",
    "mist2":   "{{ mist.2 }}",
    "mist3":   "{{ mist.3 }}",
    "spark.red":    "{{ spark.red }}",
    "spark.orange": "{{ spark.orange }}",
    "spark.amber":  "{{ spark.amber }}",
    "spark.green":  "{{ spark.green }}",
    "spark.violet": "{{ spark.violet }}"
  },

  "colors": {
    "focusBorder": "{{ role.focus_ring }}",
    "foreground": "{{ role.fg }}",
    "errorForeground": "{{ role.error }}",
    "descriptionForeground": "{{ role.fg_muted }}",
    "icon.foreground": "{{ role.fg }}",
    "selection.background": "{{ role.selection_bg | rgba 33 }}",

    "editor.background": "{{ role.bg }}",
    "editor.foreground": "{{ role.fg }}",
    "editor.lineHighlightBackground": "{{ role.line_highlight }}",
    "editor.selectionBackground": "{{ role.selection_bg | rgba 2E }}",
    "editor.selectionHighlightBackground": "{{ role.selection_bg | rgba 20 }}",
    "editor.inactiveSelectionBackground": "{{ role.selection_bg | rgba 18 }}",
    "editor.wordHighlightBackground": "{{ role.interactive | rgba 22 }}",
    "editor.wordHighlightStrongBackground": "{{ role.interactive | rgba 40 }}",
    "editor.findMatchBackground": "{{ role.attention | rgba 66 }}",
    "editor.findMatchHighlightBackground": "{{ role.attention | rgba 33 }}",
    "editor.findRangeHighlightBackground": "{{ role.attention | rgba 22 }}",
    "editorCursor.foreground": "{{ role.cursor }}",
    "editorCursor.background": "{{ role.bg }}",
    "editorWhitespace.foreground": "{{ role.border }}",
    "editorIndentGuide.background1": "{{ role.separator }}",
    "editorIndentGuide.activeBackground1": "{{ role.fg_muted }}",
    "editorRuler.foreground": "{{ role.separator }}",
    "editorBracketMatch.background": "{{ role.bg_active }}",
    "editorBracketMatch.border": "{{ role.interactive }}",
    "editorLineNumber.foreground": "{{ role.fg_muted }}",
    "editorLineNumber.activeForeground": "{{ role.fg }}",
    "editorOverviewRuler.border": "{{ role.divider }}",
    "editorOverviewRuler.findMatchForeground": "{{ role.attention }}",
    "editorOverviewRuler.errorForeground": "{{ role.error }}",
    "editorOverviewRuler.warningForeground": "{{ role.warning }}",
    "editorOverviewRuler.infoForeground": "{{ role.info }}",
    "editorOverviewRuler.modifiedForeground": "{{ role.diff_modified }}",
    "editorOverviewRuler.addedForeground": "{{ role.diff_added }}",
    "editorOverviewRuler.deletedForeground": "{{ role.diff_removed }}",

    "editorError.foreground": "{{ role.error }}",
    "editorWarning.foreground": "{{ role.warning }}",
    "editorInfo.foreground": "{{ role.info }}",
    "editorHint.foreground": "{{ role.hint }}",
    "editorGutter.modifiedBackground": "{{ role.diff_modified }}",
    "editorGutter.addedBackground": "{{ role.diff_added }}",
    "editorGutter.deletedBackground": "{{ role.diff_removed }}",

    "editorBracketHighlight.foreground1": "{{ role.bracket.1 }}",
    "editorBracketHighlight.foreground2": "{{ role.bracket.2 }}",
    "editorBracketHighlight.foreground3": "{{ role.bracket.3 }}",
    "editorBracketHighlight.foreground4": "{{ role.bracket.4 }}",
    "editorBracketHighlight.foreground5": "{{ role.bracket.5 }}",
    "editorBracketHighlight.foreground6": "{{ role.bracket.6 }}",

    "diffEditor.insertedTextBackground": "{{ role.diff_added | rgba 22 }}",
    "diffEditor.removedTextBackground": "{{ role.diff_removed | rgba 22 }}",
    "diffEditor.insertedLineBackground": "{{ role.diff_added | rgba 1A }}",
    "diffEditor.removedLineBackground": "{{ role.diff_removed | rgba 1A }}",

    "editorWidget.background": "{{ role.bg_panel }}",
    "editorWidget.foreground": "{{ role.fg }}",
    "editorWidget.border": "{{ role.border }}",
    "editorSuggestWidget.background": "{{ role.bg_panel }}",
    "editorSuggestWidget.foreground": "{{ role.fg }}",
    "editorSuggestWidget.highlightForeground": "{{ role.interactive }}",
    "editorSuggestWidget.selectedBackground": "{{ role.selection_bg | rgba 22 }}",
    "editorSuggestWidget.border": "{{ role.border }}",
