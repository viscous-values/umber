{
  "manifest_version": 3,
  "name": "{{ var.name }}",
  "version": "1.0.1",
  "description": "Umber palette family — {{ var.name }} (Chromium/Chrome theme).",
  "author": "viscous-values",
  "homepage_url": "https://github.com/viscous-values/umber",

  "icons": {
    "48":  "icons/icon-48.png",
    "96":  "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "theme": {
    "colors": {
      "frame":                          [{{ role.bg | rgb_sp }}],
      "frame_inactive":                 [{{ role.bg_panel | rgb_sp }}],
      "frame_incognito":                [{{ role.bg | rgb_sp }}],
      "frame_incognito_inactive":       [{{ role.bg_panel | rgb_sp }}],

      "toolbar":                        [{{ role.bg_panel | rgb_sp }}],
      "toolbar_text":                   [{{ role.fg_strong | rgb_sp }}],
      "toolbar_button_icon":            [{{ role.fg_muted | rgb_sp }}],
      "omnibox_background":             [{{ role.bg_raised | rgb_sp }}],
      "omnibox_text":                   [{{ role.fg_strong | rgb_sp }}],

      "tab_text":                       [{{ role.fg_emphasis | rgb_sp }}],
      "tab_background_text":            [{{ role.fg_muted | rgb_sp }}],
      "tab_background_text_inactive":   [{{ role.fg_muted | rgb_sp }}],
      "background_tab":                 [{{ role.bg_panel | rgb_sp }}],
      "background_tab_inactive":        [{{ role.bg_panel | rgb_sp }}],

      "bookmark_text":                  [{{ role.fg_emphasis | rgb_sp }}],
      "ntp_background":                 [{{ role.bg | rgb_sp }}],
      "ntp_text":                       [{{ role.fg_emphasis | rgb_sp }}],
      "ntp_link":                       [{{ role.link | rgb_sp }}],
      "ntp_header":                     [{{ role.fg_emphasis | rgb_sp }}],

      "control_background":             [{{ role.bg_raised | rgb_sp }}],
      "button_background":              [{{ role.bg_raised | rgb_sp }}]
    },
    "tints": {
      "buttons":      [-1, -1, 0.78],
      "frame":        [-1, -1, -1],
      "background_tab": [-1, -1, -1]
    },
    "properties": {
      "ntp_background_alignment": "center",
      "ntp_logo_alternate":       1
    }
  }
}
