# Umber — KDE Plasma 6 color scheme
# Palette: 16 colors in 4 tiers (Hearth, Glow, Mist, Spark). Source of truth: palette-preview.svg in the repo root.
#   Hearth (surfaces):  {{ hearth.0 }} {{ hearth.1 }} {{ hearth.2 }} {{ hearth.3 }}
#   Glow (warm fgs):    {{ glow.0 }} {{ glow.1 }} {{ glow.2 }} {{ glow.3 }}
#   Mist (cool accents): {{ mist.0 }} {{ mist.1 }} {{ mist.2 }} {{ mist.3 }}
#   Spark (vivid):       red {{ spark.red }}  orange {{ spark.orange }}  amber {{ spark.amber }}  green {{ spark.green }}  violet {{ spark.violet }}
# Negative=spark.red, Neutral=spark.amber, Positive=spark.green, Visited=spark.violet (web-link convention).

[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
