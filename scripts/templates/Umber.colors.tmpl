# Umber — KDE Plasma 6 color scheme
# Generated from the palette TOML + roles.toml by scripts/render_palette.py — edit those, not this file.
#   Hearth (surfaces):  {{ hearth.0 }} {{ hearth.1 }} {{ hearth.2 }} {{ hearth.3 }}
#   Glow (warm fgs):    {{ glow.0 }} {{ glow.1 }} {{ glow.2 }} {{ glow.3 }}
#   Mist (cool accents): {{ mist.0 }} {{ mist.1 }} {{ mist.2 }} {{ mist.3 }}
#   Spark (vivid):       red {{ spark.red }}  orange {{ spark.orange }}  amber {{ spark.amber }}  green {{ spark.green }}  violet {{ spark.violet }}
# Every key below is a semantic role (role.link, role.on_selection.fg, ...); see roles.toml for the mapping.

[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

