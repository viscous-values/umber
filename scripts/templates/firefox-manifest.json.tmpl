{
  "manifest_version": 2,
  "name": "{{ var.name }}",
  "version": "1.0.1",
  "description": "Umber palette family — {{ var.name }} (Firefox theme).",
  "author": "viscous-values",
  "homepage_url": "https://github.com/viscous-values/umber",

  "browser_specific_settings": {
    "gecko": {
      "id": "{{ var.slug }}@viscous-values"
    }
  },

  "icons": {
    "48":  "icons/icon-48.png",
    "96":  "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "theme": {
    "colors": {
      "frame":               "{{ role.bg }}",
      "frame_inactive":      "{{ role.bg_panel }}",

      "toolbar":             "{{ role.bg_panel }}",
      "toolbar_top_separator":    "{{ role.separator }}",
      "toolbar_bottom_separator": "{{ role.separator }}",
      "toolbar_vertical_separator": "{{ role.separator }}",

      "toolbar_field":            "{{ role.bg_raised }}",
      "toolbar_field_text":       "{{ role.fg_strong }}",
      "toolbar_field_border":     "{{ role.input_border }}",
      "toolbar_field_focus":      "{{ role.bg_active }}",
      "toolbar_field_text_focus": "{{ role.fg_emphasis }}",
      "toolbar_field_border_focus": "{{ role.focus_ring }}",
      "toolbar_field_highlight":  "{{ role.selection_bg }}",
      "toolbar_field_highlight_text": "{{ role.on_selection.fg }}",

      "tab_text":                "{{ role.fg_emphasis }}",
      "tab_loading":             "{{ role.accent }}",
      "tab_line":                "{{ role.accent }}",
      "tab_selected":            "{{ role.bg_raised }}",
      "tab_background_text":     "{{ role.fg_muted }}",
      "tab_background_separator": "{{ role.separator }}",

      "bookmark_text":           "{{ role.fg_emphasis }}",

      "icons":                   "{{ role.fg_muted }}",
      "icons_attention":         "{{ role.attention }}",

      "popup":                   "{{ role.bg_panel }}",
      "popup_text":              "{{ role.fg_strong }}",
      "popup_border":            "{{ role.border }}",
      "popup_highlight":         "{{ role.bg_raised }}",
      "popup_highlight_text":    "{{ role.fg_emphasis }}",

      "sidebar":                 "{{ role.bg_panel }}",
      "sidebar_text":            "{{ role.fg_strong }}",
      "sidebar_border":          "{{ role.separator }}",
      "sidebar_highlight":       "{{ role.selection_bg }}",
      "sidebar_highlight_text":  "{{ role.on_selection.fg }}",

      "button_background_hover":  "{{ role.bg_raised }}",
      "button_background_active": "{{ role.bg_active }}",

      "ntp_background":          "{{ role.bg }}",
      "ntp_text":                "{{ role.fg_emphasis }}",
      "ntp_card_background":     "{{ role.bg_panel }}",

      "address_bar_box_text":    "{{ role.fg_strong }}",
      "address_bar_box_focus":   "{{ role.bg_active }}",

      "tab_attention":           "{{ role.attention }}"
    },
    "properties": {
      "color_scheme":          "dark",
      "content_color_scheme":  "system"
    }
  }
}
