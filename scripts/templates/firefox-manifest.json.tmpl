{
  "manifest_version": 2,
  "name": "{{ var.name }}",
  "version": "1.0.0",
  "description": "Umber palette family — {{ var.name }} (Firefox theme).",
  "author": "viscous-values",
  "homepage_url": "https://github.com/viscous-values/umber",

  "browser_specific_settings": {
    "gecko": {
      "id": "{{ var.slug }}@tyler"
    }
  },

  "icons": {
    "48":  "icons/icon-48.png",
    "96":  "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "theme": {
    "colors": {
      "frame":               "{{ hearth.0 }}",
      "frame_inactive":      "{{ hearth.1 }}",

      "toolbar":             "{{ hearth.1 }}",
      "toolbar_top_separator":    "{{ hearth.2 }}",
      "toolbar_bottom_separator": "{{ hearth.2 }}",
      "toolbar_vertical_separator": "{{ hearth.2 }}",

      "toolbar_field":            "{{ hearth.2 }}",
      "toolbar_field_text":       "{{ glow.3 }}",
      "toolbar_field_border":     "{{ hearth.3 }}",
      "toolbar_field_focus":      "{{ hearth.3 }}",
      "toolbar_field_text_focus": "{{ glow.2 }}",
      "toolbar_field_border_focus": "{{ accent.highlight }}",
      "toolbar_field_highlight":  "{{ accent.highlight }}",
      "toolbar_field_highlight_text": "{{ accent.highlight_text }}",

      "tab_text":                "{{ glow.2 }}",
      "tab_loading":             "{{ accent.highlight }}",
      "tab_line":                "{{ accent.highlight }}",
      "tab_selected":            "{{ hearth.2 }}",
      "tab_background_text":     "{{ glow.0 }}",
      "tab_background_separator": "{{ hearth.2 }}",

      "bookmark_text":           "{{ glow.2 }}",

      "icons":                   "{{ glow.0 }}",
      "icons_attention":         "{{ spark.amber }}",

      "popup":                   "{{ hearth.1 }}",
      "popup_text":              "{{ glow.3 }}",
      "popup_border":            "{{ hearth.3 }}",
      "popup_highlight":         "{{ hearth.2 }}",
      "popup_highlight_text":    "{{ glow.2 }}",

      "sidebar":                 "{{ hearth.1 }}",
      "sidebar_text":            "{{ glow.3 }}",
      "sidebar_border":          "{{ hearth.2 }}",
      "sidebar_highlight":       "{{ accent.highlight }}",
      "sidebar_highlight_text":  "{{ accent.highlight_text }}",

      "button_background_hover":  "{{ hearth.2 }}",
      "button_background_active": "{{ hearth.3 }}",

      "ntp_background":          "{{ hearth.0 }}",
      "ntp_text":                "{{ glow.2 }}",
      "ntp_card_background":     "{{ hearth.1 }}",

      "address_bar_box_text":    "{{ glow.3 }}",
      "address_bar_box_focus":   "{{ hearth.3 }}",

      "tab_attention":           "{{ spark.amber }}"
    },
    "properties": {
      "color_scheme":          "dark",
      "content_color_scheme":  "system"
    }
  }
}
