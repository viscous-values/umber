# Copyright (C) 2026 Tyler — GPL-3.0-or-later
# Spark accent hexes adapted from Atom One Dark.

[General]
Description={{ var.name }}
Opacity=1
Wallpaper=
Anchor=0.5,0.5
Blur=false
ColorRandomization=false
FillStyle=Tile
WallpaperFlipType=NoFlip
WallpaperOpacity=1

[Background]
Color={{ role.ansi.bg | rgb }}
[BackgroundFaint]
Color={{ role.ansi.bg | rgb }}
[BackgroundIntense]
Color={{ role.ansi.bg | rgb }}

[Foreground]
Color={{ role.ansi.fg | rgb }}
[ForegroundFaint]
Color={{ role.ansi.fg_faint | rgb }}
[ForegroundIntense]
Color={{ role.ansi.fg_intense | rgb }}

# 0 — black / dim background tone (intense = warm glow0 for parity with VSCode)
[Color0]
Color={{ role.ansi.black | rgb }}
[Color0Faint]
Color={{ role.ansi.faint_black | rgb }}
[Color0Intense]
Color={{ role.ansi.bright_black | rgb }}

# 1 — red (spark.red)
[Color1]
Color={{ role.ansi.red | rgb }}
[Color1Faint]
Color=160,77,84
[Color1Intense]
Color=235,133,144

# 2 — green (spark.green)
[Color2]
Color={{ role.ansi.green | rgb }}
[Color2Faint]
Color=109,140,86
[Color2Intense]
Color=181,214,144

# 3 — yellow / amber (spark.amber)
[Color3]
Color={{ role.ansi.yellow | rgb }}
[Color3Faint]
Color=164,138,88
[Color3Intense]
Color=240,207,142

# 4 — blue (mist1; intense = mist2)
[Color4]
Color={{ role.ansi.blue | rgb }}
[Color4Faint]
Color=87,116,143
[Color4Intense]
Color={{ role.ansi.bright_blue | rgb }}

# 5 — magenta (spark.violet)
[Color5]
Color={{ role.ansi.magenta | rgb }}
[Color5Faint]
Color=141,96,138
[Color5Intense]
Color=213,160,194

# 6 — cyan / teal (mist0)
[Color6]
Color={{ role.ansi.cyan | rgb }}
[Color6Faint]
Color=80,128,131
[Color6Intense]
Color=156,196,199

# 7 — default text (glow1)
[Color7]
Color={{ role.ansi.white | rgb }}
[Color7Faint]
Color={{ role.ansi.faint_white | rgb }}
[Color7Intense]
Color={{ role.ansi.bright_white | rgb }}
