# Spark accent hexes adapted from Atom One Dark.

[General]
Description={{ var.name }}
Opacity=1
Wallpaper=
Anchor=0.5,0.5
Blur=false
ColorRandomization=false
FillStyle=Tile
WallpaperFlipType=NoFlip
WallpaperOpacity=1

[Background]
Color={{ role.ansi.bg | rgb }}
[BackgroundFaint]
Color={{ role.ansi.bg | rgb }}
[BackgroundIntense]
Color={{ role.ansi.bg | rgb }}

[Foreground]
Color={{ role.ansi.fg | rgb }}
[ForegroundFaint]
Color={{ role.ansi.fg_faint | rgb }}
[ForegroundIntense]
Color={{ role.ansi.fg_intense | rgb }}

# 0 — black (role.ansi.black; intense = role.ansi.bright_black)
[Color0]
Color={{ role.ansi.black | rgb }}
[Color0Faint]
Color={{ role.ansi.faint_black | rgb }}
[Color0Intense]
Color={{ role.ansi.bright_black | rgb }}

# 1 — red (role.ansi.red)
[Color1]
Color={{ role.ansi.red | rgb }}
[Color1Faint]
Color={{ role.ansi.faint_red | rgb }}
[Color1Intense]
Color={{ role.ansi.bright_red | rgb }}

# 2 — green (role.ansi.green)
[Color2]
Color={{ role.ansi.green | rgb }}
[Color2Faint]
Color={{ role.ansi.faint_green | rgb }}
[Color2Intense]
Color={{ role.ansi.bright_green | rgb }}

# 3 — yellow (role.ansi.yellow)
[Color3]
Color={{ role.ansi.yellow | rgb }}
[Color3Faint]
Color={{ role.ansi.faint_yellow | rgb }}
[Color3Intense]
Color={{ role.ansi.bright_yellow | rgb }}

# 4 — blue (role.ansi.blue)
[Color4]
Color={{ role.ansi.blue | rgb }}
[Color4Faint]
Color={{ role.ansi.faint_blue | rgb }}
[Color4Intense]
Color={{ role.ansi.bright_blue | rgb }}

# 5 — magenta (role.ansi.magenta)
[Color5]
Color={{ role.ansi.magenta | rgb }}
[Color5Faint]
Color={{ role.ansi.faint_magenta | rgb }}
[Color5Intense]
Color={{ role.ansi.bright_magenta | rgb }}

# 6 — cyan (role.ansi.cyan)
[Color6]
Color={{ role.ansi.cyan | rgb }}
[Color6Faint]
Color={{ role.ansi.faint_cyan | rgb }}
[Color6Intense]
Color={{ role.ansi.bright_cyan | rgb }}

# 7 — white / default text (role.ansi.white)
[Color7]
Color={{ role.ansi.white | rgb }}
[Color7Faint]
Color={{ role.ansi.faint_white | rgb }}
[Color7Intense]
Color={{ role.ansi.bright_white | rgb }}
