# Umber — Konsole 16-ANSI color scheme
# Part of the Umber theme suite — https://github.com/tyler872010/umber
# Copyright (C) 2026 Tyler — GPL-3.0-or-later
# Spark accent hexes adapted from Atom One Dark.

[General]
Description=Umber
Opacity=1
Wallpaper=
Anchor=0.5,0.5
Blur=false
ColorRandomization=false
FillStyle=Tile
WallpaperFlipType=NoFlip
WallpaperOpacity=1

[Background]
Color={{ hearth.0 | rgb }}
[BackgroundFaint]
Color={{ hearth.0 | rgb }}
[BackgroundIntense]
Color={{ hearth.0 | rgb }}

[Foreground]
Color={{ glow.1 | rgb }}
[ForegroundFaint]
Color={{ glow.0 | rgb }}
[ForegroundIntense]
Color={{ glow.3 | rgb }}

# 0 — black / dim background tone (intense = warm glow0 for parity with VSCode)
[Color0]
Color={{ hearth.1 | rgb }}
[Color0Faint]
Color={{ hearth.1 | rgb }}
[Color0Intense]
Color={{ glow.0 | rgb }}

# 1 — red (spark.red)
[Color1]
Color={{ spark.red | rgb }}
[Color1Faint]
Color=160,77,84
[Color1Intense]
Color=235,133,144

# 2 — green (spark.green)
[Color2]
Color={{ spark.green | rgb }}
[Color2Faint]
Color=109,140,86
[Color2Intense]
Color=181,214,144

# 3 — yellow / amber (spark.amber)
[Color3]
Color={{ spark.amber | rgb }}
[Color3Faint]
Color=164,138,88
[Color3Intense]
Color=240,207,142

# 4 — blue (mist1; intense = mist2)
[Color4]
Color={{ mist.1 | rgb }}
[Color4Faint]
Color=87,116,143
[Color4Intense]
Color={{ mist.2 | rgb }}

# 5 — magenta (spark.violet)
[Color5]
Color={{ spark.violet | rgb }}
[Color5Faint]
Color=141,96,138
[Color5Intense]
Color=213,160,194

# 6 — cyan / teal (mist0)
[Color6]
Color={{ mist.0 | rgb }}
[Color6Faint]
Color=80,128,131
[Color6Intense]
Color=156,196,199

# 7 — default text (glow1)
[Color7]
Color={{ glow.1 | rgb }}
[Color7Faint]
Color={{ glow.0 | rgb }}
[Color7Intense]
Color={{ glow.3 | rgb }}
