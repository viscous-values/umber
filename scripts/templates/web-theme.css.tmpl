/* {{ var.name }}: Umber 2.1.0 web export.
 *
 * One custom property per role in roles.toml, resolved for this variant.
 * Name = the role path with "." and "_" written as "-":
 *   bg_panel -> --umber-bg-panel, on_selection.fg -> --umber-on-selection-fg,
 *   syntax.keyword -> --umber-syntax-keyword, bracket.1 -> --umber-bracket-1.
 * Values are plain hex; mix tints in CSS, e.g.
 *   color-mix(in srgb, var(--umber-error) 12%, var(--umber-bg)).
 *
 * Generated by scripts/render_palette.py from roles.toml and this variant's
 * palette. Edit those, never this file. https://github.com/viscous-values/umber
 *
 * SPDX-License-Identifier: GPL-3.0-or-later OR MIT
 */
[data-theme="{{ var.slug }}"] {
	color-scheme: dark;

	/* Surfaces, deepest to most raised */
	--umber-bg: {{ role.bg }};
	--umber-bg-panel: {{ role.bg_panel }};
	--umber-bg-raised: {{ role.bg_raised }};
	--umber-bg-active: {{ role.bg_active }};
	--umber-bg-overlay: {{ role.bg_overlay }};
	--umber-line-highlight: {{ role.line_highlight }};

	/* Lines */
	--umber-border: {{ role.border }};
	--umber-input-border: {{ role.input_border }};
	--umber-divider: {{ role.divider }};
	--umber-separator: {{ role.separator }};

	/* Text */
	--umber-fg: {{ role.fg }};
	--umber-fg-muted: {{ role.fg_muted }};
	--umber-fg-emphasis: {{ role.fg_emphasis }};
	--umber-fg-strong: {{ role.fg_strong }};
	--umber-fg-on-accent: {{ role.fg_on_accent }};
	--umber-cursor: {{ role.cursor }};

	/* Hover on an active surface; shadow color for scrims */
	--umber-bg-active-hover: {{ role.bg_active_hover }};
	--umber-shadow: {{ role.shadow }};

	/* Identity and interaction */
	--umber-accent: {{ role.accent }};
	--umber-interactive: {{ role.interactive }};
	--umber-interactive-hover: {{ role.interactive_hover }};
	--umber-button-bg: {{ role.button_bg }};
	--umber-button-hover: {{ role.button_hover }};
	--umber-focus-ring: {{ role.focus_ring }};
	--umber-decoration-focus: {{ role.decoration_focus }};
	--umber-decoration-hover: {{ role.decoration_hover }};

	/* Links */
	--umber-link: {{ role.link }};
	--umber-link-visited: {{ role.link_visited }};

	/* Selection */
	--umber-selection-bg: {{ role.selection_bg }};
	--umber-selection-alt: {{ role.selection_alt }};

	/* Status */
	--umber-error: {{ role.error }};
	--umber-warning: {{ role.warning }};
	--umber-success: {{ role.success }};
	--umber-info: {{ role.info }};
	--umber-hint: {{ role.hint }};
	--umber-debug: {{ role.debug }};
	--umber-attention: {{ role.attention }};
	--umber-brand: {{ role.brand }};

	/* Version control */
	--umber-diff-added: {{ role.diff_added }};
	--umber-diff-removed: {{ role.diff_removed }};
	--umber-diff-modified: {{ role.diff_modified }};

	/* Text drawn on the selection background (>= 4.5:1 on selection-bg) */
	--umber-on-selection-fg: {{ role.on_selection.fg }};
	--umber-on-selection-fg-soft: {{ role.on_selection.fg_soft }};
	--umber-on-selection-fg-inactive: {{ role.on_selection.fg_inactive }};
	--umber-on-selection-decoration: {{ role.on_selection.decoration }};
	--umber-on-selection-link: {{ role.on_selection.link }};
	--umber-on-selection-visited: {{ role.on_selection.visited }};
	--umber-on-selection-negative: {{ role.on_selection.negative }};
	--umber-on-selection-neutral: {{ role.on_selection.neutral }};
	--umber-on-selection-positive: {{ role.on_selection.positive }};

	/* Code */
	--umber-syntax-comment: {{ role.syntax.comment }};
	--umber-syntax-keyword: {{ role.syntax.keyword }};
	--umber-syntax-storage: {{ role.syntax.storage }};
	--umber-syntax-builtin: {{ role.syntax.builtin }};
	--umber-syntax-macro: {{ role.syntax.macro }};
	--umber-syntax-operator: {{ role.syntax.operator }};
	--umber-syntax-punctuation: {{ role.syntax.punctuation }};
	--umber-syntax-function: {{ role.syntax.function }};
	--umber-syntax-namespace: {{ role.syntax.namespace }};
	--umber-syntax-type: {{ role.syntax.type }};
	--umber-syntax-class: {{ role.syntax.class }};
	--umber-syntax-decorator: {{ role.syntax.decorator }};
	--umber-syntax-attribute: {{ role.syntax.attribute }};
	--umber-syntax-string: {{ role.syntax.string }};
	--umber-syntax-number: {{ role.syntax.number }};
	--umber-syntax-constant: {{ role.syntax.constant }};
	--umber-syntax-escape: {{ role.syntax.escape }};
	--umber-syntax-regex: {{ role.syntax.regex }};
	--umber-syntax-variable: {{ role.syntax.variable }};
	--umber-syntax-parameter: {{ role.syntax.parameter }};
	--umber-syntax-property: {{ role.syntax.property }};
	--umber-syntax-key: {{ role.syntax.key }};
	--umber-syntax-tag: {{ role.syntax.tag }};
	--umber-syntax-heading: {{ role.syntax.heading }};
	--umber-syntax-emphasis: {{ role.syntax.emphasis }};
	--umber-syntax-markup-link: {{ role.syntax.markup_link }};
	--umber-syntax-markup-code: {{ role.syntax.markup_code }};
	--umber-syntax-markup-list: {{ role.syntax.markup_list }};
	--umber-syntax-quote: {{ role.syntax.quote }};
	--umber-syntax-invalid: {{ role.syntax.invalid }};
	--umber-syntax-deprecated: {{ role.syntax.deprecated }};

	/* Bracket pairs, outermost first */
	--umber-bracket-1: {{ role.bracket.1 }};
	--umber-bracket-2: {{ role.bracket.2 }};
	--umber-bracket-3: {{ role.bracket.3 }};
	--umber-bracket-4: {{ role.bracket.4 }};
	--umber-bracket-5: {{ role.bracket.5 }};
	--umber-bracket-6: {{ role.bracket.6 }};

	/* Terminal */
	--umber-ansi-bg: {{ role.ansi.bg }};
	--umber-ansi-fg: {{ role.ansi.fg }};
	--umber-ansi-fg-faint: {{ role.ansi.fg_faint }};
	--umber-ansi-fg-intense: {{ role.ansi.fg_intense }};
	--umber-ansi-cursor: {{ role.ansi.cursor }};
	--umber-ansi-black: {{ role.ansi.black }};
	--umber-ansi-red: {{ role.ansi.red }};
	--umber-ansi-green: {{ role.ansi.green }};
	--umber-ansi-yellow: {{ role.ansi.yellow }};
	--umber-ansi-blue: {{ role.ansi.blue }};
	--umber-ansi-magenta: {{ role.ansi.magenta }};
	--umber-ansi-cyan: {{ role.ansi.cyan }};
	--umber-ansi-white: {{ role.ansi.white }};
	--umber-ansi-bright-black: {{ role.ansi.bright_black }};
	--umber-ansi-bright-blue: {{ role.ansi.bright_blue }};
	--umber-ansi-bright-white: {{ role.ansi.bright_white }};
	--umber-ansi-bright-red: {{ role.ansi.bright_red }};
	--umber-ansi-bright-green: {{ role.ansi.bright_green }};
	--umber-ansi-bright-yellow: {{ role.ansi.bright_yellow }};
	--umber-ansi-bright-magenta: {{ role.ansi.bright_magenta }};
	--umber-ansi-bright-cyan: {{ role.ansi.bright_cyan }};
	--umber-ansi-faint-black: {{ role.ansi.faint_black }};
	--umber-ansi-faint-red: {{ role.ansi.faint_red }};
	--umber-ansi-faint-green: {{ role.ansi.faint_green }};
	--umber-ansi-faint-yellow: {{ role.ansi.faint_yellow }};
	--umber-ansi-faint-blue: {{ role.ansi.faint_blue }};
	--umber-ansi-faint-magenta: {{ role.ansi.faint_magenta }};
	--umber-ansi-faint-cyan: {{ role.ansi.faint_cyan }};
	--umber-ansi-faint-white: {{ role.ansi.faint_white }};
}
