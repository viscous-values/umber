{
  "manifest_version": 3,
  "name": "Umber",
  "version": "1.0.0",
  "description": "A quiet warm-on-charcoal Chromium/Chrome theme — Umber palette.",
  "author": "Tyler",
  "homepage_url": "https://github.com/tyler872010/hush",

  "theme": {
    "colors": {
      "frame":                          [36, 36, 36],
      "frame_inactive":                 [43, 43, 43],
      "frame_incognito":                [36, 36, 36],
      "frame_incognito_inactive":       [43, 43, 43],

      "toolbar":                        [43, 43, 43],
      "toolbar_text":                   [225, 225, 225],
      "toolbar_button_icon":            [168, 153, 134],
      "omnibox_background":             [51, 51, 51],
      "omnibox_text":                   [225, 225, 225],

      "tab_text":                       [225, 205, 165],
      "tab_background_text":            [168, 153, 134],
      "tab_background_text_inactive":   [168, 153, 134],
      "background_tab":                 [43, 43, 43],
      "background_tab_inactive":        [43, 43, 43],

      "bookmark_text":                  [225, 205, 165],
      "ntp_background":                 [36, 36, 36],
      "ntp_text":                       [225, 205, 165],
      "ntp_link":                       [212, 188, 145],
      "ntp_header":                     [225, 205, 165],

      "control_background":             [51, 51, 51],
      "button_background":              [51, 51, 51]
    },
    "tints": {
      "buttons":      [-1, -1, 0.78],
      "frame":        [-1, -1, -1],
      "background_tab": [-1, -1, -1]
    },
    "properties": {
      "ntp_background_alignment": "center",
      "ntp_logo_alternate":       1
    }
  }
