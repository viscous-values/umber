{
  "manifest_version": 3,
  "name": "Umber",
  "version": "2.1.0",
  "description": "Umber palette family — Umber (Chromium/Chrome theme).",
  "author": "viscous-values",
  "homepage_url": "https://github.com/viscous-values/umber",

  "icons": {
    "48":  "icons/icon-48.png",
    "96":  "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "theme": {
    "colors": {
      "frame":                          [41, 27, 14],
      "frame_inactive":                 [50, 36, 23],
      "frame_incognito":                [41, 27, 14],
      "frame_incognito_inactive":       [50, 36, 23],

      "toolbar":                        [50, 36, 23],
      "toolbar_text":                   [247, 237, 221],
      "toolbar_button_icon":            [170, 158, 139],
      "omnibox_background":             [60, 46, 33],
      "omnibox_text":                   [247, 237, 221],

      "tab_text":                       [235, 218, 191],
      "tab_background_text":            [170, 158, 139],
      "tab_background_text_inactive":   [170, 158, 139],
      "background_tab":                 [50, 36, 23],
      "background_tab_inactive":        [50, 36, 23],

      "bookmark_text":                  [235, 218, 191],
      "ntp_background":                 [41, 27, 14],
      "ntp_text":                       [235, 218, 191],
      "ntp_link":                       [128, 186, 228],
      "ntp_header":                     [235, 218, 191],

      "control_background":             [60, 46, 33],
      "button_background":              [60, 46, 33]
    },
    "tints": {
      "buttons":      [-1, -1, 0.78],
      "frame":        [-1, -1, -1],
      "background_tab": [-1, -1, -1]
    },
    "properties": {
      "ntp_background_alignment": "center",
      "ntp_logo_alternate":       1
    }
  }
}
