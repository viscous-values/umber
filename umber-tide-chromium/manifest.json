{
  "manifest_version": 3,
  "name": "Umber Tide",
  "version": "2.0.0",
  "description": "Umber palette family — Umber Tide (Chromium/Chrome theme).",
  "author": "viscous-values",
  "homepage_url": "https://github.com/viscous-values/umber",

  "icons": {
    "48":  "icons/icon-48.png",
    "96":  "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "theme": {
    "colors": {
      "frame":                          [9, 35, 33],
      "frame_inactive":                 [18, 44, 42],
      "frame_incognito":                [9, 35, 33],
      "frame_incognito_inactive":       [18, 44, 42],

      "toolbar":                        [18, 44, 42],
      "toolbar_text":                   [236, 240, 231],
      "toolbar_button_icon":            [157, 162, 150],
      "omnibox_background":             [28, 54, 52],
      "omnibox_text":                   [236, 240, 231],

      "tab_text":                       [217, 223, 209],
      "tab_background_text":            [157, 162, 150],
      "tab_background_text_inactive":   [157, 162, 150],
      "background_tab":                 [18, 44, 42],
      "background_tab_inactive":        [18, 44, 42],

      "bookmark_text":                  [217, 223, 209],
      "ntp_background":                 [9, 35, 33],
      "ntp_text":                       [217, 223, 209],
      "ntp_link":                       [124, 192, 227],
      "ntp_header":                     [217, 223, 209],

      "control_background":             [28, 54, 52],
      "button_background":              [28, 54, 52]
    },
    "tints": {
      "buttons":      [-1, -1, 0.78],
      "frame":        [-1, -1, -1],
      "background_tab": [-1, -1, -1]
    },
    "properties": {
      "ntp_background_alignment": "center",
      "ntp_logo_alternate":       1
    }
  }
}
