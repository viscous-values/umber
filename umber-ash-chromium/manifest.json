{
  "manifest_version": 3,
  "name": "Umber Ash",
  "version": "1.0.1",
  "description": "Umber palette family — Umber Ash (Chromium/Chrome theme).",
  "author": "viscous-values",
  "homepage_url": "https://github.com/viscous-values/umber",

  "icons": {
    "48":  "icons/icon-48.png",
    "96":  "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "theme": {
    "colors": {
      "frame":                          [30, 30, 30],
      "frame_inactive":                 [39, 39, 39],
      "frame_incognito":                [30, 30, 30],
      "frame_incognito_inactive":       [39, 39, 39],

      "toolbar":                        [39, 39, 39],
      "toolbar_text":                   [239, 238, 235],
      "toolbar_button_icon":            [161, 160, 156],
      "omnibox_background":             [49, 49, 49],
      "omnibox_text":                   [239, 238, 235],

      "tab_text":                       [221, 220, 216],
      "tab_background_text":            [161, 160, 156],
      "tab_background_text_inactive":   [161, 160, 156],
      "background_tab":                 [39, 39, 39],
      "background_tab_inactive":        [39, 39, 39],

      "bookmark_text":                  [221, 220, 216],
      "ntp_background":                 [30, 30, 30],
      "ntp_text":                       [221, 220, 216],
      "ntp_link":                       [133, 176, 225],
      "ntp_header":                     [221, 220, 216],

      "control_background":             [49, 49, 49],
      "button_background":              [49, 49, 49]
    },
    "tints": {
      "buttons":      [-1, -1, 0.78],
      "frame":        [-1, -1, -1],
      "background_tab": [-1, -1, -1]
    },
    "properties": {
      "ntp_background_alignment": "center",
      "ntp_logo_alternate":       1
    }
  }
}
