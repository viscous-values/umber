{
  "manifest_version": 2,
  "name": "Umber",
  "version": "1.0.1",
  "description": "Umber palette family — Umber (Firefox theme).",
  "author": "viscous-values",
  "homepage_url": "https://github.com/viscous-values/umber",

  "browser_specific_settings": {
    "gecko": {
      "id": "umber@viscous-values"
    }
  },

  "icons": {
    "48":  "icons/icon-48.png",
    "96":  "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "theme": {
    "colors": {
      "frame":               "#291B0E",
      "frame_inactive":      "#322417",

      "toolbar":             "#322417",
      "toolbar_top_separator":    "#3C2E21",
      "toolbar_bottom_separator": "#3C2E21",
      "toolbar_vertical_separator": "#3C2E21",

      "toolbar_field":            "#3C2E21",
      "toolbar_field_text":       "#F7EDDD",
      "toolbar_field_border":     "#7E7064",
      "toolbar_field_focus":      "#51443A",
      "toolbar_field_text_focus": "#EBDABF",
      "toolbar_field_border_focus": "#EB9251",
      "toolbar_field_highlight":  "#E3B492",
      "toolbar_field_highlight_text": "#2E1C0B",

      "tab_text":                "#EBDABF",
      "tab_loading":             "#EB9251",
      "tab_line":                "#EB9251",
      "tab_selected":            "#3C2E21",
      "tab_background_text":     "#AA9E8B",
      "tab_background_separator": "#3C2E21",

      "bookmark_text":           "#EBDABF",

      "icons":                   "#AA9E8B",
      "icons_attention":         "#EDD473",

      "popup":                   "#322417",
      "popup_text":              "#F7EDDD",
      "popup_border":            "#51443A",
      "popup_highlight":         "#3C2E21",
      "popup_highlight_text":    "#EBDABF",

      "sidebar":                 "#322417",
      "sidebar_text":            "#F7EDDD",
      "sidebar_border":          "#3C2E21",
      "sidebar_highlight":       "#E3B492",
      "sidebar_highlight_text":  "#2E1C0B",

      "button_background_hover":  "#3C2E21",
      "button_background_active": "#51443A",

      "ntp_background":          "#291B0E",
      "ntp_text":                "#EBDABF",
      "ntp_card_background":     "#322417",

      "address_bar_box_text":    "#F7EDDD",
      "address_bar_box_focus":   "#51443A",

      "tab_attention":           "#EDD473"
    },
    "properties": {
      "color_scheme":          "dark",
      "content_color_scheme":  "system"
    }
  }
}
