{
  "manifest_version": 2,
  "name": "Umber Slate",
  "version": "1.0.1",
  "description": "Umber palette family — Umber Slate (Firefox theme).",
  "author": "viscous-values",
  "homepage_url": "https://github.com/viscous-values/umber",

  "browser_specific_settings": {
    "gecko": {
      "id": "umber-slate@tyler"
    }
  },

  "icons": {
    "48":  "icons/icon-48.png",
    "96":  "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "theme": {
    "colors": {
      "frame":               "#232527",
      "frame_inactive":      "#2A2C2F",

      "toolbar":             "#2A2C2F",
      "toolbar_top_separator":    "#323438",
      "toolbar_bottom_separator": "#323438",
      "toolbar_vertical_separator": "#323438",

      "toolbar_field":            "#323438",
      "toolbar_field_text":       "#ECE5D7",
      "toolbar_field_border":     "#434548",
      "toolbar_field_focus":      "#434548",
      "toolbar_field_text_focus": "#D8CDB2",
      "toolbar_field_border_focus": "#88A6C5",
      "toolbar_field_highlight":  "#88A6C5",
      "toolbar_field_highlight_text": "#232527",

      "tab_text":                "#D8CDB2",
      "tab_loading":             "#88A6C5",
      "tab_line":                "#88A6C5",
      "tab_selected":            "#323438",
      "tab_background_text":     "#A39A8E",
      "tab_background_separator": "#323438",

      "bookmark_text":           "#D8CDB2",

      "icons":                   "#A39A8E",
      "icons_attention":         "#E5C07B",

      "popup":                   "#2A2C2F",
      "popup_text":              "#ECE5D7",
      "popup_border":            "#434548",
      "popup_highlight":         "#323438",
      "popup_highlight_text":    "#D8CDB2",

      "sidebar":                 "#2A2C2F",
      "sidebar_text":            "#ECE5D7",
      "sidebar_border":          "#323438",
      "sidebar_highlight":       "#88A6C5",
      "sidebar_highlight_text":  "#232527",

      "button_background_hover":  "#323438",
      "button_background_active": "#434548",

      "ntp_background":          "#232527",
      "ntp_text":                "#D8CDB2",
      "ntp_card_background":     "#2A2C2F",

      "address_bar_box_text":    "#ECE5D7",
      "address_bar_box_focus":   "#434548",

      "tab_attention":           "#E5C07B"
    },
    "properties": {
      "color_scheme":          "dark",
      "content_color_scheme":  "system"
    }
  }
}
