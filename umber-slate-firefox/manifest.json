{
  "manifest_version": 2,
  "name": "Umber Slate",
  "version": "2.0.0",
  "description": "Umber palette family — Umber Slate (Firefox theme).",
  "author": "viscous-values",
  "homepage_url": "https://github.com/viscous-values/umber",

  "browser_specific_settings": {
    "gecko": {
      "id": "umber-slate@viscous-values"
    }
  },

  "icons": {
    "48":  "icons/icon-48.png",
    "96":  "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "theme": {
    "colors": {
      "frame":               "#132029",
      "frame_inactive":      "#1B2932",

      "toolbar":             "#1B2932",
      "toolbar_top_separator":    "#25333C",
      "toolbar_bottom_separator": "#25333C",
      "toolbar_vertical_separator": "#25333C",

      "toolbar_field":            "#25333C",
      "toolbar_field_text":       "#ECEFF0",
      "toolbar_field_border":     "#68757E",
      "toolbar_field_focus":      "#3D4951",
      "toolbar_field_text_focus": "#DADDDE",
      "toolbar_field_border_focus": "#A4C485",
      "toolbar_field_highlight":  "#C0D2AC",
      "toolbar_field_highlight_text": "#132231",

      "tab_text":                "#DADDDE",
      "tab_loading":             "#A4C485",
      "tab_line":                "#A4C485",
      "tab_selected":            "#25333C",
      "tab_background_text":     "#9DA0A2",
      "tab_background_separator": "#25333C",

      "bookmark_text":           "#DADDDE",

      "icons":                   "#9DA0A2",
      "icons_attention":         "#F2D07D",

      "popup":                   "#1B2932",
      "popup_text":              "#ECEFF0",
      "popup_border":            "#3D4951",
      "popup_highlight":         "#25333C",
      "popup_highlight_text":    "#DADDDE",

      "sidebar":                 "#1B2932",
      "sidebar_text":            "#ECEFF0",
      "sidebar_border":          "#25333C",
      "sidebar_highlight":       "#C0D2AC",
      "sidebar_highlight_text":  "#132231",

      "button_background_hover":  "#25333C",
      "button_background_active": "#3D4951",

      "ntp_background":          "#132029",
      "ntp_text":                "#DADDDE",
      "ntp_card_background":     "#1B2932",

      "address_bar_box_text":    "#ECEFF0",
      "address_bar_box_focus":   "#3D4951",

      "tab_attention":           "#F2D07D"
    },
    "properties": {
      "color_scheme":          "dark",
      "content_color_scheme":  "system"
    }
  }
}
