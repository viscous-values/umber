{
  "manifest_version": 3,
  "name": "Umber Slate",
  "version": "1.0.1",
  "description": "Umber palette family — Umber Slate (Chromium/Chrome theme).",
  "author": "viscous-values",
  "homepage_url": "https://github.com/viscous-values/umber",

  "icons": {
    "48":  "icons/icon-48.png",
    "96":  "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "theme": {
    "colors": {
      "frame":                          [19, 32, 41],
      "frame_inactive":                 [27, 41, 50],
      "frame_incognito":                [19, 32, 41],
      "frame_incognito_inactive":       [27, 41, 50],

      "toolbar":                        [27, 41, 50],
      "toolbar_text":                   [236, 239, 240],
      "toolbar_button_icon":            [157, 160, 162],
      "omnibox_background":             [37, 51, 60],
      "omnibox_text":                   [236, 239, 240],

      "tab_text":                       [218, 221, 222],
      "tab_background_text":            [157, 160, 162],
      "tab_background_text_inactive":   [157, 160, 162],
      "background_tab":                 [27, 41, 50],
      "background_tab_inactive":        [27, 41, 50],

      "bookmark_text":                  [218, 221, 222],
      "ntp_background":                 [19, 32, 41],
      "ntp_text":                       [218, 221, 222],
      "ntp_link":                       [148, 179, 225],
      "ntp_header":                     [218, 221, 222],

      "control_background":             [37, 51, 60],
      "button_background":              [37, 51, 60]
    },
    "tints": {
      "buttons":      [-1, -1, 0.78],
      "frame":        [-1, -1, -1],
      "background_tab": [-1, -1, -1]
    },
    "properties": {
      "ntp_background_alignment": "center",
      "ntp_logo_alternate":       1
    }
  }
}
